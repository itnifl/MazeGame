<?xml version="1.0" encoding="UTF-8"?>
<walls:WallModel
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:walls="http://main.game.maze/walls"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    >

  <materials
      id="GLASS_BASIC"
      displayName="Glass"
      wallBaseType="GLASS"
      breakable="true"
      hitPoints="5"
      baseImage="glassWall.png"/>

  <materials
      id="DIRT_BASIC"
      displayName="Dirt"
      wallBaseType="DIRT"
      breakable="true"
      hitPoints="10"
      baseImage="dirtWall.png"/>

  <materials
      id="WOOD_BASIC"
      displayName="Wood"
      wallBaseType="WOOD"
      breakable="true"
      hitPoints="20"
      baseImage="woodWall.png"/>

  <materials
      id="STONE_BASIC"
      displayName="Stone"
      wallBaseType="STONE"
      breakable="true"
      hitPoints="40"
      baseImage="stoneWall.png"/>

  <materials
      id="STEEL_SOLID"
      displayName="Steel"
      wallBaseType="STEEL"
      breakable="false"
      hitPoints="0"
      baseImage="steelWall.png"/>

</walls:WallModel>
