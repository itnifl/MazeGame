 main.game.maze.dsl.ui.highlighting,
 main.game.maze.dsl.ui.labeling,
 main.game.maze.dsl.ui.outline,
 main.game.maze.dsl.ui.quickfix
Require-Bundle: main.game.maze.dsl,
 main.game.maze.dsl.ide,
 org.eclipse.xtext.ui,
 org.eclipse.xtext.ui.shared,
 org.eclipse.xtext.ui.codetemplates.ui,
 org.eclipse.ui.editors,
 org.eclipse.ui.ide,
 org.eclipse.ui,
 org.eclipse.compare,
 org.eclipse.xtext.builder,
 org.eclipse.xtext.xbase.lib;bundle-version="2.42.0"
Bundle-ActivationPolicy: lazy

