Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: main.game.maze.dsl.ui;singleton:=true
Automatic-Module-Name: main.game.maze.dsl.ui
Bundle-Version: 1.0.0.qualifier
Bundle-ClassPath: .
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-Activator: main.game.maze.dsl.ui.internal.DslActivator
Bundle-RequiredExecutionEnvironment: JavaSE-21
Export-Package: main.game.maze.dsl.ui,
