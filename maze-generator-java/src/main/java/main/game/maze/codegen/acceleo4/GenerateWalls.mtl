package main.game.maze.generated;

import java.util.function.Consumer;
import java.util.logging.Logger;

import main.game.maze.walls.WallMaterial;
import main.game.maze.walls.WallMaterialBaseType;

/**
 * Generated collision handler for wall materials.
 * Handles damage, destruction, and collision response by material type.
 * 
 * @generated from walls.ecore using Acceleo 4
 */
public final class WallCollisionHandler {

    private static final Logger LOGGER = Logger.getLogger(WallCollisionHandler.class.getName());

    private WallCollisionHandler() { /* utility class */ }

    /**
     * Result of a collision with a wall.
     */
    public record CollisionResult(
        boolean wallDestroyed,
        int damageDealt,
        int remainingHitPoints,
        String soundEffect,
        String particleEffect
    ) {}

    /**
     * Handles a collision/attack on a wall material.
     * 
     * @param material the wall material being hit
     * @param incomingDamage the damage amount
     * @param onDestroyed callback when wall is destroyed (may be null)
     * @return collision result with effects to apply
     */
    public static CollisionResult handleCollision(WallMaterial material, int incomingDamage, 
                                                   Consumer<WallMaterial> onDestroyed) {
        if (material == null) {
            return new CollisionResult(false, 0, 0, "wall_generic_hit", "debris_generic");
        }

        WallMaterialBaseType baseType = material.getWallBaseType();
        boolean isBreakable = material.isBreakable();
        
        if (!isBreakable) {
            // Unbreakable wall - no damage dealt
            return new CollisionResult(
                false,
                0,
                0,
                getImpactSound(baseType),
                getImpactParticle(baseType)
            );
        }

        // Calculate damage based on material resistance
        int effectiveDamage = calculateEffectiveDamage(incomingDamage, baseType);
        int currentHp = material.getHitPoints();
        int newHp = Math.max(0, currentHp - effectiveDamage);
        
        boolean destroyed = newHp <= 0;
        
        if (destroyed && onDestroyed != null) {
            onDestroyed.accept(material);
        }

        return new CollisionResult(
            destroyed,
            effectiveDamage,
            newHp,
            destroyed ? getDestroySound(baseType) : getHitSound(baseType),
            destroyed ? getDestroyParticle(baseType) : getDamageParticle(baseType)
        );
    }

    /**
     * Calculates effective damage after material resistance.
     * 
     * @param baseDamage incoming damage amount
     * @param baseType the material type
     * @return damage after resistance
     */
    public static int calculateEffectiveDamage(int baseDamage, WallMaterialBaseType baseType) {
        if (baseType == null) return baseDamage;
        
        double multiplier = switch (baseType) {
            case GLASS -> 2.0;   // glass takes double damage
            case DIRT -> 1.5;    // dirt is weak
            case WOOD -> 1.0;    // wood is baseline
            case STONE -> 0.75;  // stone is resistant
            case STEEL -> 0.5;   // steel is very resistant
        };

        return (int) Math.ceil(baseDamage * multiplier);
    }

    /**
     * Gets the base damage resistance for a material type.
     * 
     * @param baseType the material type
     * @return resistance value (higher = more resistant)
     */
    public static int getResistance(WallMaterialBaseType baseType) {
        if (baseType == null) return 0;
        
        return switch (baseType) {
            case GLASS -> 0;
            case DIRT -> 1;
            case WOOD -> 2;
            case STONE -> 3;
            case STEEL -> 5;
        };
    }

    // Sound effect helpers
    private static String getImpactSound(WallMaterialBaseType baseType) {
        return switch (baseType) {
            case GLASS -> "wall_glass_crack";
            case DIRT -> "wall_dirt_thud";
            case WOOD -> "wall_wood_knock";
            case STONE -> "wall_stone_chip";
            case STEEL -> "wall_steel_clang";
        };
    }

    private static String getHitSound(WallMaterialBaseType baseType) {
        return switch (baseType) {
            case GLASS -> "wall_glass_hit";
            case DIRT -> "wall_dirt_hit";
            case WOOD -> "wall_wood_hit";
            case STONE -> "wall_stone_hit";
            case STEEL -> "wall_steel_hit";
        };
    }

    private static String getDestroySound(WallMaterialBaseType baseType) {
        return switch (baseType) {
            case GLASS -> "wall_glass_shatter";
            case DIRT -> "wall_dirt_crumble";
            case WOOD -> "wall_wood_splinter";
            case STONE -> "wall_stone_crack";
            case STEEL -> "wall_steel_collapse";
        };
    }

    // Particle effect helpers
    private static String getImpactParticle(WallMaterialBaseType baseType) {
        return switch (baseType) {
            case GLASS -> "particle_spark";
            case DIRT -> "particle_dust";
            case WOOD -> "particle_splinter";
            case STONE -> "particle_chip";
            case STEEL -> "particle_spark";
        };
    }

    private static String getDamageParticle(WallMaterialBaseType baseType) {
        return switch (baseType) {
            case GLASS -> "particle_glass_crack";
            case DIRT -> "particle_dirt_dust";
            case WOOD -> "particle_wood_chip";
            case STONE -> "particle_stone_dust";
            case STEEL -> "particle_steel_spark";
        };
    }

    private static String getDestroyParticle(WallMaterialBaseType baseType) {
        return switch (baseType) {
            case GLASS -> "particle_glass_shatter";
            case DIRT -> "particle_dirt_collapse";
            case WOOD -> "particle_wood_debris";
            case STONE -> "particle_stone_rubble";
            case STEEL -> "particle_steel_debris";
        };
    }
}
