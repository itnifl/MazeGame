package main.game.maze.generated;

import java.util.logging.Logger;
import main.game.maze.difficulties.*;

/**
 * Generated difficulty registry with factory methods.
 * @generated from difficulty-module.ecore using Acceleo 4
 */
public final class DifficultyRegistry {

    private static final Logger LOGGER = Logger.getLogger(DifficultyRegistry.class.getName());

    private DifficultyRegistry() { /* utility class */ }

    /**
     * Creates a difficulty instance by type name.
     * @param typeName the difficulty type name (e.g., "EasyDifficulty")
     * @return new difficulty instance or null if unknown
     */
    public static Difficulty createByName(String typeName) {
        if (typeName == null) return null;
        
        return switch (typeName) {
            case "EasyDifficulty" -> DifficultiesFactory.eINSTANCE.createEasyDifficulty();
            case "NormalDifficulty" -> DifficultiesFactory.eINSTANCE.createNormalDifficulty();
            case "HardDifficulty" -> DifficultiesFactory.eINSTANCE.createHardDifficulty();
            default -> {
                LOGGER.warning("Unknown difficulty type: " + typeName);
                yield null;
            }
        };
    }

    /**
     * Configures default multipliers for a difficulty based on type.
     * @param difficulty the difficulty to configure
     */
    public static void configureDefaults(Difficulty difficulty) {
        if (difficulty == null) return;
        
        switch (difficulty.eClass().getName()) {
            case "EasyDifficulty" -> {
                difficulty.setMonstersMovementSpeedMultiplier(0.8);
                difficulty.setMonstersDamageMultiplier(0.5);
                difficulty.setMaxThreat(15);
                difficulty.setInstantDeath(false);
            }
            case "NormalDifficulty" -> {
                difficulty.setMonstersMovementSpeedMultiplier(1.0);
                difficulty.setMonstersDamageMultiplier(1.0);
                difficulty.setMaxThreat(20);
                difficulty.setInstantDeath(false);
            }
            case "HardDifficulty" -> {
                difficulty.setMonstersMovementSpeedMultiplier(1.5);
                difficulty.setMonstersDamageMultiplier(2.0);
                difficulty.setMaxThreat(30);
                difficulty.setInstantDeath(true);
            }
            default -> LOGGER.warning("Unknown difficulty type for defaults: " + difficulty.eClass().getName());
        }
    }

    /**
     * Gets all difficulty type names.
     * @return array of type names
     */
    public static String['['/][']'/] getAllDifficultyTypes() {
        return new String['['/][']'/] {
            "EasyDifficulty",
            "NormalDifficulty",
            "HardDifficulty"
        };
    }
}
