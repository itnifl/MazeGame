package main.game.maze.generated;

import main.game.maze.difficulties.*;

/**
 * Generated configurator for difficulty settings.
 * Eliminates instanceof chains by using switch on difficulty class name.
 * 
 * @generated from difficulty-module.ecore using Acceleo 4
 */
public final class DifficultyConfigurator {

    private DifficultyConfigurator() { /* utility class */ }

    /**
     * Applies difficulty multipliers to game settings.
     * 
     * @param difficulty the active difficulty instance
     * @return a DifficultySettings record with all multipliers
     */
    public static DifficultySettings configure(Difficulty difficulty) {
        if (difficulty == null) {
            return DifficultySettings.DEFAULT;
        }
        
        return new DifficultySettings(
            difficulty.getMaxThreat(),
            difficulty.getMonstersMovementSpeedMultiplier(),
            difficulty.getMonstersDamageMultiplier(),
            difficulty.isInstantDeath(),
            difficulty.eClass().getName()
        );
    }

    /**
     * Gets the difficulty key (lowercase class name) for profile resolution.
     * 
     * @param difficulty the difficulty instance
     * @return lowercase key like "easy", "normal", "hard"
     */
    public static String getDifficultyKey(Difficulty difficulty) {
        if (difficulty == null) {
            return "normal";
        }
        return switch (difficulty.eClass().getName()) {
            [for (diff : difficulties::Difficulty | gameData.difficulties)]
            case "[diff.eClass().name/]" -> "[diff.eClass().name.toLower()/]";
            [/for]
            default -> "normal";
        };
    }

    /**
     * Gets all known difficulty type names from the model.
     * @return array of difficulty type names
     */
    public static String['['/][']'/] getKnownDifficultyTypes() {
        return new String['['/][']'/] {
            [for (diff : difficulties::Difficulty | gameData.difficulties) separator(', ')]"[diff.eClass().name/]"[/for]
        };
    }

    /**
     * Gets the difficulty count defined in the model.
     * @return number of difficulty levels
     */
    public static int getDifficultyCount() {
        return [gameData.difficulties->size()/];
    }

    /**
     * Checks if a difficulty type name is known.
     * @param typeName the type name to check
     * @return true if known
     */
    public static boolean isKnownDifficultyType(String typeName) {
        return switch (typeName) {
            [for (diff : difficulties::Difficulty | gameData.difficulties)]
            case "[diff.eClass().name/]" -> true;
            [/for]
            default -> false;
        };
    }

    /**
     * Immutable record holding all difficulty settings.
     */
    public record DifficultySettings(
        int maxThreat,
        double speedMultiplier,
        double damageMultiplier,
        boolean instantDeath,
        String difficultyName
    ) {
        public static final DifficultySettings DEFAULT = new DifficultySettings(
            20, 1.0, 1.0, false, "Normal"
        );
    }
}
