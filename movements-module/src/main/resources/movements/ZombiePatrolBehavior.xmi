<?xml version="1.0" encoding="UTF-8"?>
<behaviour:PatrolBehavior
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:behaviour="http://main.game.maze/behaviour"
    xsi:schemaLocation="http://main.game.maze/behaviour movements.ecore"
    attackRadius="10.0">
  <path time="4"
      regenAmount="10">
    <point posX="10.0"
        posY="230.0"/>
  </path>
  <path time="4">
    <point posX="380.0"
        posY="230.0"/>
  </path>
  <pathcalculator
      xsi:type="behaviour:LocalPathCalculator"/>
</behaviour:PatrolBehavior>
