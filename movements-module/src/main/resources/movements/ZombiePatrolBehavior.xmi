<?xml version="1.0" encoding="UTF-8"?>
<behaviour:PatrolBehavior
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:behaviour="http://main.game.maze/behaviour"
    xsi:schemaLocation="http://main.game.maze/behaviour movements.ecore"
    attackRadius="10.0"
    movementSpeed="3.0"
    visionRadius="30.0">
  <path regenAmount="10.0">
    <point posX="10.0"
        posY="230.0"/>
    <events
        xsi:type="behaviour:PatrolHealthEvent"
        probability="50"
        healthAmount="10.0"
        healthPercentage="2"/>
    <events
        xsi:type="behaviour:PatrolTimeEvent"
        probability="100"
        time="2"/>
  </path>
  <path>
    <point posX="380.0"
        posY="230.0"/>
    <events
        xsi:type="behaviour:PatrolTimeEvent"
        probability="80"
        time="2"/>
  </path>
  <pathcalculator
      xsi:type="behaviour:LocalPathCalculator"/>
</behaviour:PatrolBehavior>
