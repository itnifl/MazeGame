<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- The shop between levels (#164). View only: ShopController fills the item cards from the shared ShopMenu model; the
     look (textures, colours, tier badges) is the menu theme model, applied through FxMenuTheme, the same theme the libGDX
     shop draws. -->
<AnchorPane fx:id="screenRoot" prefHeight="800" prefWidth="600" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8"
            fx:controller="main.game.maze.ShopController" onKeyPressed="#handleKeyPressed" focusTraversable="true">
   <children>
        <ImageView fx:id="backdrop" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                   preserveRatio="false" fitWidth="${screenRoot.width}" fitHeight="${screenRoot.height}" />
        <Pane styleClass="menu-vignette" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" />
        <StackPane alignment="CENTER" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
            <children>
                <VBox styleClass="menu-panel" alignment="TOP_CENTER" maxWidth="780" maxHeight="-Infinity" spacing="5">
                    <children>
                        <Region styleClass="menu-hazard" maxWidth="Infinity" />
                        <StackPane styleClass="menu-banner" maxWidth="-Infinity">
                            <children>
                                <Label fx:id="titleLabel" styleClass="menu-banner-text" text="SUPPLY DEPOT" />
                            </children>
                        </StackPane>
                        <Label fx:id="subtitleLabel" styleClass="menu-muted" text="" />
                        <HBox alignment="CENTER" spacing="8">
                            <children>
                                <ImageView fx:id="tokenIcon" fitWidth="24" fitHeight="24" preserveRatio="true" />
                                <Label fx:id="creditsLabel" styleClass="menu-credits" text="Score to spend: 0" />
                            </children>
                        </HBox>
                        <HBox fx:id="shelvesBox" spacing="8" alignment="TOP_CENTER" />
                        <Label fx:id="briefingLabel" styleClass="menu-briefing" wrapText="true" maxWidth="700" text="" />
                        <Label fx:id="statusLabel" wrapText="true" styleClass="menu-text" text="" />
                        <Label fx:id="helpLabel" styleClass="menu-muted" text="" />
                        <Region styleClass="menu-hazard" maxWidth="Infinity" />
                        <HBox alignment="CENTER" spacing="16">
                            <children>
                                <Button fx:id="buyButton" onAction="#buySelected" focusTraversable="false" />
                                <Button fx:id="doneButton" onAction="#close" focusTraversable="false" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
   </children>
</AnchorPane>
