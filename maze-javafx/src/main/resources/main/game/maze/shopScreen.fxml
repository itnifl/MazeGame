<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- The shop between levels (#164). View only: ShopController fills the rows from the shared ShopMenu model. -->
<AnchorPane fx:id="screenRoot" prefHeight="800" prefWidth="600" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8"
            fx:controller="main.game.maze.ShopController" onKeyPressed="#handleKeyPressed" focusTraversable="true">
   <children>
        <ImageView AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                   preserveRatio="false" fitWidth="${screenRoot.width}" fitHeight="${screenRoot.height}">
            <image>
                <Image url="@/main/game/maze/zombieGameOverBackground1.png"/>
            </image>
        </ImageView>
        <Pane AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
              style="-fx-background-color: rgba(0,0,0,0.45);" />
        <StackPane alignment="CENTER" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
            <children>
                <VBox alignment="TOP_CENTER" maxWidth="560" maxHeight="700" spacing="6"
                      style="-fx-background-color: rgba(0,0,0,0.9); -fx-border-color: #ffe56e; -fx-border-width: 2; -fx-padding: 16 20 16 20;">
                    <children>
                        <Label fx:id="titleLabel" style="-fx-font-size: 26px; -fx-text-fill: #ffe56e; -fx-font-family: 'Consolas'; -fx-font-weight: bold;" text="SHOP" />
                        <Label fx:id="creditsLabel" style="-fx-font-size: 16px; -fx-text-fill: #8fffe0; -fx-font-family: 'Consolas'; -fx-font-weight: bold;" text="Score to spend: 0" />
                        <VBox fx:id="itemsBox" spacing="3" />
                        <Label fx:id="statusLabel" wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #d7fff5; -fx-font-family: 'Consolas';" text="" />
                        <Label fx:id="helpLabel" style="-fx-font-size: 12px; -fx-text-fill: #9aa4b0; -fx-font-family: 'Consolas';" text="" />
                        <HBox alignment="CENTER" spacing="12">
                            <children>
                                <Button fx:id="buyButton" onAction="#buySelected" focusTraversable="false"
                                        style="-fx-padding: 6 18 6 18; -fx-background-color: #4ade80; -fx-text-fill: #06310f; -fx-font-family: 'Consolas'; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4;" text="Buy" />
                                <Button fx:id="doneButton" onAction="#close" focusTraversable="false"
                                        style="-fx-padding: 6 18 6 18; -fx-background-color: #ffe56e; -fx-text-fill: #2f1d00; -fx-font-family: 'Consolas'; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4;" text="Done" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
   </children>
</AnchorPane>
