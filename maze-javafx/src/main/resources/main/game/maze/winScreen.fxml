<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- The win screen between levels. View only: the look (textures, colours, the buttons' plates) is the menu theme model,
     applied by WinGameController through FxMenuTheme, the same theme the libGDX win screen draws. -->
<AnchorPane fx:id="screenRoot" prefHeight="800" prefWidth="600" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8" fx:controller="main.game.maze.WinGameController">
   <children>
        <ImageView fx:id="backdrop" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                   preserveRatio="false" pickOnBounds="true" fitWidth="${screenRoot.width}" fitHeight="${screenRoot.height}" />
        <Pane styleClass="menu-vignette" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" />
        <StackPane alignment="CENTER" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
            <children>
                <VBox styleClass="menu-panel" alignment="TOP_CENTER" maxWidth="640" maxHeight="-Infinity" spacing="10">
                    <children>
                        <Region styleClass="menu-hazard" maxWidth="Infinity" />
                        <StackPane styleClass="menu-banner" maxWidth="-Infinity">
                            <children>
                                <Label fx:id="winHeaderLabel" styleClass="menu-banner-text" text="YOU WIN" />
                            </children>
                        </StackPane>
                        <Label styleClass="menu-muted" text="Mission report - save your score, stock up in the shop, or move on" />
                        <Label styleClass="menu-heading" text="YOUR SCORE" />
                        <HBox alignment="CENTER" spacing="10">
                            <children>
                                <ImageView fx:id="tokenIcon" fitWidth="34" fitHeight="34" preserveRatio="true" />
                                <Label fx:id="scoreLabel" styleClass="menu-score" text="0" />
                            </children>
                        </HBox>
                        <Label fx:id="damagePenaltyNoticeLabel" managed="false" visible="false" styleClass="menu-bad" text="- Including damage penalty" />
                        <Label fx:id="winBonusNoticeLabel" styleClass="menu-accent" text="- Including win bonus" />
                        <Region styleClass="menu-hazard" maxWidth="Infinity" />
                        <HBox alignment="CENTER" spacing="12">
                            <children>
                                <Button fx:id="saveButton" onAction="#saveScore" />
                                <Button fx:id="shopButton" onAction="#openShop" />
                                <Button fx:id="nextLevelButton" onAction="#nextLevel" />
                                <Button fx:id="restartButton" onAction="#restartLevel" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
   </children>
</AnchorPane>
