<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- The main menu. View only: the texts are the shared StartMenuText and the look (textures, colours, the buttons'
     plates) is the menu theme model, applied by StartController through FxMenuTheme, as on the libGDX main menu. -->
<AnchorPane fx:id="screenRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.game.maze.StartController">

    <ImageView fx:id="backdrop" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
               preserveRatio="false" fitWidth="${screenRoot.width}" fitHeight="${screenRoot.height}" />
    <Pane styleClass="menu-vignette" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" />

    <VBox alignment="CENTER" spacing="10" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
        <StackPane styleClass="menu-banner" maxWidth="-Infinity">
            <Label fx:id="titleLabel" styleClass="menu-banner-text, menu-title" />
        </StackPane>
        <Label fx:id="subtitleLabel" styleClass="menu-credits" />

        <VBox styleClass="menu-panel" alignment="CENTER" spacing="10" maxWidth="560" maxHeight="-Infinity">
            <Region styleClass="menu-hazard" maxWidth="Infinity" />
            <Label fx:id="selectLabel" styleClass="menu-heading" />
            <ComboBox fx:id="difficultyCombo" styleClass="menu-combo" prefWidth="340" />

            <HBox alignment="CENTER" spacing="14">
                <Button fx:id="startButton" onAction="#onStart" prefWidth="170" />
                <Button fx:id="highScoresButton" onAction="#onHighScores" prefWidth="170" />
            </HBox>
            <Button fx:id="loadButton" onAction="#onLoad" prefWidth="354" />

            <Label fx:id="controlsLabel" styleClass="menu-muted" wrapText="true" maxWidth="480" />
            <Label fx:id="error" styleClass="menu-bad" />
            <Region styleClass="menu-hazard" maxWidth="Infinity" />
        </VBox>

        <Label fx:id="taglineLabel" styleClass="menu-price" />
    </VBox>
</AnchorPane>
