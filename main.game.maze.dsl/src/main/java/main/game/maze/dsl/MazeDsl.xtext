/*
 * MazeGame DSL Grammar
 * 
 * This grammar defines a textual DSL for configuring MazeGame levels,
 * including difficulties, opponents, patrol behaviors, and loot tables.
 */
grammar main.game.maze.dsl.MazeDsl with org.eclipse.xtext.common.Terminals

generate mazeDsl "http://www.main.game.maze/dsl/MazeDsl"
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

/*
 * Root element - A game configuration containing all game elements
 */
GameConfiguration:
    'game' name=ValidID '{'
        (imports+=Import)*
        (difficulty=DifficultyConfig)?
        (opponents+=OpponentConfig)*
        (patrols+=PatrolConfig)*
        (lootTables+=LootTableConfig)*
        (levels+=LevelConfig)*
    '}'
;

/*
 * Import statement for referencing external XMI files
 */
Import:
    'import' importURI=STRING
;

/*
 * Difficulty configuration section
 */
DifficultyConfig:
    'difficulty' '{'
        'level' level=DifficultyLevel
        ('instantDeath' instantDeath?='true')?
        ('speedMultiplier' speedMultiplier=DOUBLE)?
        ('damageMultiplier' damageMultiplier=DOUBLE)?
        ('maxThreat' maxThreat=SIGNED_INT)?
        (enemyLimits+=EnemyLimit)*
    '}'
;

enum DifficultyLevel:
    EASY='easy' | NORMAL='normal' | HARD='hard'
;

/*
 * Enemy count limits per type
 */
EnemyLimit:
    'limit' type=EnemyType 'max' maxCount=SIGNED_INT
;

enum EnemyType:
    ZOMBIE='zombie' | GHOST='ghost' | PUMPKINBOMBER='pumpkinbomber'
;

/*
 * Opponent/Enemy configuration
 */
OpponentConfig:
    'opponent' name=ValidID '{'
        'type' type=CharacterTypeEnum
        ('displayName' displayName=STRING)?
        ('health' health=SIGNED_INT)?
        ('speed' speed=DOUBLE)?
        ('threatLevel' threatLevel=DOUBLE)?
        ('enabled' enabled=BOOLEAN)?
        ('behavior' behavior=BehaviorTypeEnum)?
        (characterSpecifics=CharacterSpecifics)?
        ('patrol' patrolRef=[PatrolConfig|ValidID])?
        ('loot' lootRef=[LootTableConfig|ValidID])?
    '}'
;

enum CharacterTypeEnum:
    ZOMBIE='zombie' | GHOST='ghost' | PUMPKINBOMBER='pumpkinbomber'
;

enum BehaviorTypeEnum:
    PASSIVE='passive' | WANDER='wander' | AGGRESSIVE='aggressive' | PATROL='patrol'
;

/*
 * Character-specific attributes (zombie, ghost, or ranged enemy)
 */
CharacterSpecifics:
    ZombieSpecifics | GhostSpecifics | RangedSpecifics
;

ZombieSpecifics:
    {ZombieSpecifics}
    'zombie-stats' '{'
        ('attackDamage' attackDamage=INT)?
        ('infectionLevel' infectionLevel=INT)?
        ('resurrectionTime' resurrectionTime=INT)?
    '}'
;

GhostSpecifics:
    {GhostSpecifics}
    'ghost-stats' '{'
        ('attackDamage' attackDamage=INT)?
        ('visibilityLevel' visibilityLevel=INT)?
        ('nonTangibilityEnergy' nonTangibilityEnergy=DOUBLE)?
    '}'
;

RangedSpecifics:
    {RangedSpecifics}
    'ranged-stats' '{'
        ('attackRange' attackRange=DOUBLE)?
        ('attackCooldown' attackCooldown=INT)?
        ('attackDamage' attackDamage=INT)?
        ('projectileSpeed' projectileSpeed=DOUBLE)?
        ('projectileType' projectileType=ProjectileTypeEnum)?
        ('splashRadius' splashRadius=DOUBLE)?
    '}'
;

enum ProjectileTypeEnum:
    STRAIGHT='straight' | LOB='lob' | BEAM='beam'
;

/*
 * Patrol path configuration
 */
PatrolConfig:
    'patrol' name=ValidID '{'
        ('visionRange' visionRange=DOUBLE)?
        (zone=PatrolZoneConfig)?
        'path' '['
            waypoints+=Waypoint (',' waypoints+=Waypoint)*
        ']'
    '}'
;

PatrolZoneConfig:
    'zone' '{'
        'topLeft' '(' topLeftX=DOUBLE ',' topLeftY=DOUBLE ')'
        'width' width=DOUBLE
        'height' height=DOUBLE
    '}'
;

Waypoint:
    '(' x=DOUBLE ',' y=DOUBLE ')' 
    (':' waitTime=INT 'ms')?
;

/*
 * Loot table configuration
 */
LootTableConfig:
    'loot-table' name=ValidID '{'
        ('capacity' capacity=INT)?
        items+=LootItemConfig+
    '}'
;

LootItemConfig:
    'item' name=ValidID '{'
        'type' type=LootItemTypeEnum
        'value' value=INT
        ('weight' weight=INT)?
    '}'
;

enum LootItemTypeEnum:
    FOOD='food' | BOMB='bomb' | TRAP='trap' | WEAPON='weapon'
;


/*
 * A level of the game (the source of xmi/levels/levels.xmi; see levels.ecore for what each value means).
 * Scalar values are nullable on purpose: a value that is not written is "not set", so a level built on
 * another one (basedOn) takes it from there, and the model's default applies otherwise.
 */
LevelConfig:
    'level' number=INT name=STRING '{'
        ('basedOn' baseLevel=INT)?
        ('threatCapacity' threatCapacityFactor=DOUBLE_OBJECT)?
        ('wallMaterials' showWallMaterials=BOOLEAN_OBJECT)?
        ('inheritWeapons' inheritWeapons=BOOLEAN_OBJECT)?
        ('cascadeDepth' cascadeDepth=INT_OBJECT)?
        (zones+=LevelZone)*
        (sergeant=SergeantConfig)?
        (sergeantPosts+=TierCountConfig)*
        (mines=MineRingConfig)?
        (portalGhost=PortalGhostConfig)?
        (ghostCounts+=GhostCountConfig)*
        (teleport=TeleportRulesConfig)?
        (guardTower=GuardTowerConfig)?
        (towerCounts+=TowerCountConfig)*
        (wallBuilder=WallBuilderConfig)?
        (builderCounts+=BuilderCountConfig)*
    '}'
;

/* One concentric zone, outermost first; walls are made of the listed materials (ids of walls.xmi). */
LevelZone:
    'ring' displayName=STRING ('share' breakableShare=DOUBLE_OBJECT)?
    'materials' materialIds+=ID (',' materialIds+=ID)*
;

SergeantConfig:
    'sergeant' displayName=STRING '{'
        'health' health=INT
        'sightRange' sightRange=DOUBLE
        'rounds' roundsPerBurst=INT
        'roundDamage' roundDamage=INT
        'roundInterval' roundIntervalSeconds=DOUBLE
        'burstCooldown' burstCooldownSeconds=DOUBLE
        'sprite' sprite=STRING
        ('fireSound' fireSound=STRING)?
        'drops' dropWeapon=DropWeaponEnum
        'postDistance' postDistanceFromHeart=DOUBLE
    '}'
;

enum DropWeaponEnum:
    GATLING_GUN='gatling'
;

TierCountConfig:
    'sergeants' difficulty=DifficultyLevel count=INT
;

MineRingConfig:
    'mines' '{'
        'count' count=INT
        'ringRadius' ringRadius=DOUBLE
        ('secondRing' secondRingRadius=DOUBLE)?
        'triggerRadius' triggerRadius=DOUBLE
        'pulse' pulseSeconds=DOUBLE
        'blastRadius' blastRadius=DOUBLE
        'blastDamage' blastDamage=INT
        'playerDamage' playerDamage=INT
        'holeRadius' holeRadius=DOUBLE
    '}'
;

PortalGhostConfig:
    'portalGhost' displayName=STRING '{'
        'health' health=INT
        'speed' speed=DOUBLE
        'sprite' sprite=STRING
    '}'
;

GhostCountConfig:
    'portalGhosts' difficulty=DifficultyLevel count=INT
;

GuardTowerConfig:
    'guardTower' displayName=STRING '{'
        'health' health=INT
        'sightRange' sightRange=DOUBLE
        'wallsOver' maxWallsOver=INT
        'rpgInterval' rpgIntervalSeconds=DOUBLE
        'rpgSpeed' rpgSpeed=DOUBLE
        'rpgBlastRadius' rpgBlastRadius=DOUBLE
        'rpgPlayerDamage' rpgPlayerDamage=INT
        'rpgWallDamage' rpgWallDamage=INT
        'gatlingRounds' gatlingRounds=INT
        'gatlingInterval' gatlingRoundIntervalSeconds=DOUBLE
        'gatlingDamage' gatlingDamage=INT
        'deathBlast' deathBlastDamage=INT
        'sprite' sprite=STRING
        ('rpgLaunchSound' rpgLaunchSound=STRING)?
        ('rpgExplosionSound' rpgExplosionSound=STRING)?
        ('gatlingSound' gatlingSound=STRING)?
        ('hitSound' hitSound=STRING)?
        ('destroyedSound' destroyedSound=STRING)?
    '}'
;

TowerCountConfig:
    'towers' difficulty=DifficultyLevel count=INT
;

WallBuilderConfig:
    'wallBuilder' displayName=STRING '{'
        'health' health=INT
        'speed' speed=DOUBLE
        'sprite' sprite=STRING
        'buildSeconds' buildSecondsPerCorridor=DOUBLE
        'startRadius' startRadiusCells=INT
        'blockRadius' blockRadiusCells=INT
        'spawnRadius' spawnRadius=DOUBLE
        'material' wallMaterial=ID
        ('buildSound' buildSound=STRING)?
    '}'
;

BuilderCountConfig:
    'builders' difficulty=DifficultyLevel count=INT
;

TeleportRulesConfig:
    'teleport' '{'
        'cooldown' cooldownSeconds=DOUBLE
        'banner' bannerText=STRING
        'bannerSeconds' bannerSeconds=DOUBLE
        ('zapSound' zapSound=STRING)?
        ('voiceSound' voiceSound=STRING)?
    '}'
;

/*
 * Datatype rule for double values (accepts both integers and decimals)
 */
DOUBLE returns ecore::EDouble:
    ('-')? INT ('.' INT)?
;

SIGNED_INT returns ecore::EInt:
    ('-')? INT
;

/*
 * Datatype rule for boolean values
 */
BOOLEAN returns ecore::EBoolean:
    'true' | 'false'
;

/*
 * Nullable value types: left out in the source they stay null ("not set").
 */
DOUBLE_OBJECT returns ecore::EDoubleObject:
    ('-')? INT ('.' INT)?
;

INT_OBJECT returns ecore::EIntegerObject:
    ('-')? INT
;

BOOLEAN_OBJECT returns ecore::EBooleanObject:
    'true' | 'false'
;

/*
 * A name. The words the level section added to the language (basedOn, mines, gatling, teleport, ...) are still
 * allowed as names and references, so existing files that used them as identifiers keep parsing.
 */
ValidID returns ecore::EString:
    ID | 'basedOn' | 'threatCapacity' | 'wallMaterials' | 'inheritWeapons' | 'cascadeDepth' | 'ring' | 'share' | 'materials' | 'sergeant' | 'sergeants' | 'sightRange' | 'rounds' | 'roundDamage' | 'roundInterval' | 'burstCooldown' | 'sprite' | 'fireSound' | 'drops' | 'gatling' | 'postDistance' | 'mines' | 'count' | 'ringRadius' | 'triggerRadius' | 'pulse' | 'blastRadius' | 'blastDamage' | 'playerDamage' | 'holeRadius' | 'portalGhost' | 'portalGhosts' | 'teleport' | 'cooldown' | 'banner' | 'bannerSeconds' | 'zapSound' | 'voiceSound' | 'secondRing' | 'guardTower' | 'towers' | 'wallsOver' | 'rpgInterval' | 'rpgSpeed' | 'rpgBlastRadius' | 'rpgPlayerDamage' | 'rpgWallDamage' | 'gatlingRounds' | 'gatlingInterval' | 'gatlingDamage' | 'deathBlast' | 'rpgLaunchSound' | 'rpgExplosionSound' | 'gatlingSound' | 'hitSound' | 'destroyedSound' | 'wallBuilder' | 'builders' | 'buildSeconds' | 'blockRadius' | 'spawnRadius' | 'material' | 'startRadius' | 'buildSound'
;
