Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: main.game.maze.dsl;singleton:=true
Automatic-Module-Name: main.game.maze.dsl
Bundle-Version: 1.0.0.qualifier
Bundle-ClassPath: .
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: JavaSE-21
Export-Package: main.game.maze.dsl,
 main.game.maze.dsl.generator,
 main.game.maze.dsl.mazeDsl,
 main.game.maze.dsl.mazeDsl.impl,
 main.game.maze.dsl.mazeDsl.util,
 main.game.maze.dsl.parser.antlr,
 main.game.maze.dsl.parser.antlr.internal,
 main.game.maze.dsl.scoping,
 main.game.maze.dsl.serializer,
 main.game.maze.dsl.services,
 main.game.maze.dsl.validation
Require-Bundle: org.eclipse.xtext,
 org.eclipse.equinox.common;bundle-version="3.5.0",
 org.eclipse.emf.ecore,
 org.eclipse.xtext.xbase.lib;bundle-version="2.14.0",
 org.eclipse.xtext.util,
 org.eclipse.emf.common,
 org.antlr.runtime;bundle-version="[3.2.0,3.2.1)",
 main.game.maze.behaviour,
 main.game.maze.difficulties,
 main.game.maze.opponents
Bundle-ActivationPolicy: lazy
Import-Package: org.apache.log4j

