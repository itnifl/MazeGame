<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="difficulties" nsURI="http://main.game.maze/difficulty" nsPrefix="diff">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="basePackage" value="main.game.maze"/>
    <details key="resource" value="XMI"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="DifficultyGameData">
    <eStructuralFeatures xsi:type="ecore:EReference" name="difficulties" lowerBound="1"
        upperBound="-1" eType="#//Difficulty" containment="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="currentDifficulty" eType="#//Difficulty"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EasyDifficulty" eSuperTypes="#//Difficulty"/>
  <eClassifiers xsi:type="ecore:EClass" name="Difficulty" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="MaxThreatNonNegative"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="instantDeath" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="enemyMaxCount" ordered="false"
        upperBound="-1" eType="#//EnemyMaxCount" containment="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="monstersMovementSpeedMultiplier"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="monstersDamageMultiplier"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxThreat" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="NormalDifficulty" eSuperTypes="#//Difficulty"/>
  <eClassifiers xsi:type="ecore:EClass" name="HardDifficulty" eSuperTypes="#//Difficulty"/>
  <eClassifiers xsi:type="ecore:EClass" name="EnemyMaxCount">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="type" eType="#//EnemyTypes"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxCount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="EnemyTypes">
    <eLiterals name="ZOMBIE"/>
    <eLiterals name="GHOST" value="1"/>
    <eLiterals name="PUMPKINBOMBER" value="2"/>
  </eClassifiers>
</ecore:EPackage>
