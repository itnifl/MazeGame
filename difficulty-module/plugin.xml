<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>

<!--
-->

<plugin id="main.game.maze.difficulty"
    name="%pluginName"
    version="1.0.0.qualifier"
    provider-name="%providerName">

   <extension point="org.eclipse.emf.ecore.generated_package">
      <!-- @generated opponents -->
      <package
            uri="http://main.game.maze/difficulty"
            class="main.game.maze.opponents.DifficultyPackage"
            genModel="src/main/resources/difficulty-module.genmodel"/>
   </extension>


   <extension point="org.eclipse.emf.ecore.generated_package">
      <!-- @generated difficulty-module -->
      <package
            uri="http://main.game.maze/difficulty"
            class="main.game.maze.difficulties.DifficultiesPackage"
            genModel="src/main/resources/difficulty-module.genmodel"/>
   </extension>


   <extension point="org.eclipse.emf.ecore.extension_parser">
      <!-- @generated difficulty-module -->
      <parser
            type="difficulties"
            class="main.game.maze.difficulties.util.DifficultiesResourceFactoryImpl"/>
   </extension>
</plugin>
