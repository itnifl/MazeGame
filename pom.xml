
<!-- /pom.xml -->
<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>main.game.maze</groupId>
  <artifactId>MazeGame</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <tycho.version>5.0.0</tycho.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <emf.version>2.38.0</emf.version>
    <javafx.version>21.0.9</javafx.version>
    <javafx.platform>win</javafx.platform> <!-- Default, can be overridden by profile -->
    <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
  </properties>
  
  <modules>
    <!-- 1: p2 mirror bygges først -->
    <module>releng/mirror</module>

    <!-- 2: modell-/plugin-moduler -->
    <module>main.game.maze.walls</module>
    <module>main.game.maze.mazeworld</module>
    <module>main.game.maze.difficulties</module>
    <module>main.game.maze.opponents</module>
    <module>main.game.maze.behaviour</module>
    <module>maze-generator.freemarker</module>

    <!-- 3: Xtext DSL modules -->
    <module>main.game.maze.dsl</module>
    <module>main.game.maze.dsl.ide</module>
    <module>main.game.maze.dsl.ui</module>
    <module>main.game.maze.dsl.tests</module>

    <!-- 4: feature og p2-repo -->
    <module>maze-feature</module>
    <module>maze-module-repository</module>
    <module>maze-generator.freemarker-runner</module>

    <!-- Note: maze-generator-java removed from build - it contained Acceleo 4 templates
         that are no longer used. The build now uses FreeMarker-based generators in 
         maze-generator.freemarker instead. -->

    <!-- 5: evt. egen generated/jar-modul for spillet -->
    <module>maze-module-generator</module>

    <!-- 6: backend-agnostiske grafikk-/lyd-abstraksjoner og backends -->
    <module>maze-common-frontend</module>
    <module>maze-common-backend</module>
    <module>maze-javafx</module>
    <module>maze-libgdx</module>

    <!-- 7: selve JavaFX-spillet - controllers, characters, game logic -->
    <module>maze-javafx-backend</module>

  </modules>

  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>

    <repository>
      <id>eclipse-releases</id>
      <url>https://repo.eclipse.org/content/repositories/releases/</url>
    </repository>
    
    <repository>
      <id>local-p2</id>
      <layout>p2</layout>
      <url>file:${maven.multiModuleProjectDirectory}/releng/local-p2</url>
    </repository>
  </repositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-maven-plugin</artifactId>
          <version>${tycho.version}</version>
          <extensions>true</extensions>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>target-platform-configuration</artifactId>
          <version>${tycho.version}</version>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-compiler-plugin</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <compilerArgs>
              <arg>-warn:-discouraged,forbidden</arg>
              <arg>-err:-discouraged,forbidden</arg>
            </compilerArgs>
            <showWarnings>true</showWarnings>
            <useProjectSettings>true</useProjectSettings>
            <requireJavaPackageImports>false</requireJavaPackageImports>
          </configuration>
        </plugin>

        <!-- JaCoCo: version + shared config declared once here.
             Each testable module (maze-common-frontend, maze-common-backend,
             maze-javafx-backend, maze-libgdx) opts in by adding this plugin
             to its own <plugins> section without repeating the config. -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.12</version>
          <executions>
            <execution>
              <id>jacoco-prepare-agent</id>
              <goals><goal>prepare-agent</goal></goals>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <phase>verify</phase>
              <goals><goal>report</goal></goals>
            </execution>
            <execution>
              <id>jacoco-check</id>
              <phase>verify</phase>
              <goals><goal>check</goal></goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.60</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
                <excludes>
                  <exclude>main/game/maze/difficulties/impl/**</exclude>
                  <exclude>main/game/maze/opponents/impl/**</exclude>
                  <exclude>main/game/maze/difficulties/util/**</exclude>
                </excludes>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>   
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
  
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <pomDependencies>ignore</pomDependencies>
          <target> 
            <file>${maven.multiModuleProjectDirectory}/releng/maze.target</file>          
          </target>                   
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.6,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>
</project>
