 org.eclipse.emf.ecore.xmi;visibility:=reexport,
 org.eclipse.ocl.pivot;resolution:=optional
Export-Package: main.game.maze.difficulties;x-friends:="main.game.maze.behaviour,main.game.maze.opponents",
 main.game.maze.difficulties.impl;x-friends:="main.game.maze.behaviour,main.game.maze.opponents",
 main.game.maze.difficulties.util;x-friends:="main.game.maze.behaviour,main.game.maze.opponents"
Bundle-ActivationPolicy: lazy
