<!-- maze-generator.runner/pom.xml -->
<project>
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>main.game.maze</groupId>
    <artifactId>MazeGame</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>maze-generator.freemarker-runner</artifactId>
  <packaging>eclipse-plugin</packaging>

  <properties>
    <!--
      Tycho 5.0.0 tycho-eclipse-plugin:eclipse-run drops every p2 bundle from the
      <dependencies> list (see target/skippedP2Dependencies.txt). With no EMF /
      Equinox runtime bundles available the application class cannot be resolved
      and Equinox throws NullPointerException in ReferenceMap.put (exit code 13).

      The generated sources are already committed under
      maze-module-generator/src-gen, so model regeneration is only needed when an
      .xmi model actually changes. Default to skipping the eclipse-run codegen
      until the Tycho regression is sorted out. Re-enable with -Dskip.codegen=false.
    -->
    <skip.codegen>true</skip.codegen>
    <root.uri.path>${maven.multiModuleProjectDirectory}</root.uri.path>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>normalize-root-uri-path</id>
            <phase>initialize</phase>
            <goals>
              <goal>regex-property</goal>
            </goals>
            <configuration>
              <name>root.uri.path</name>
              <value>${maven.multiModuleProjectDirectory}</value>
              <regex>\\</regex>
              <replacement>/</replacement>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-eclipse-plugin</artifactId>
        <version>${tycho.version}</version>
        <executions>
         <execution>
            <id>run-acceleo-walls</id>
            <phase>generate-sources</phase>
            <goals><goal>eclipse-run</goal></goals>
            <configuration>
              <skip>${skip.codegen}</skip>
              <applicationArgs>
                <arg>-application</arg>
                <arg>maze-generator.freemarker.main.game.maze.gen.HeadlessWallsApp</arg>
                <arg>${maven.multiModuleProjectDirectory}/main.game.maze.walls/xmi/default.walls.xmi</arg>
                <arg>${maven.multiModuleProjectDirectory}/maze-module-generator/src-gen</arg>
              </applicationArgs>
              
              <executionEnvironment>JavaSE-21</executionEnvironment>
              <jvmArgs>
                <arg>-Dfile.encoding=UTF-8</arg>
              </jvmArgs>
            </configuration>
          </execution>
          <execution>
            <id>run-acceleo</id>
            <phase>generate-sources</phase>
            <goals><goal>eclipse-run</goal></goals>
            <configuration>
              <skip>${skip.codegen}</skip>
              <applicationArgs>
                <arg>-application</arg>
                <arg>maze-generator.freemarker.main.game.maze.gen.RunAcceleo</arg>
                <arg>${maven.multiModuleProjectDirectory}/maze-common-backend/src/main/resources/xmi/opponents/opponentModel.xmi</arg>
                <arg>${maven.multiModuleProjectDirectory}/maze-common-backend/src/main/resources/xmi/difficulties/difficulties.xmi</arg>
                <arg>${maven.multiModuleProjectDirectory}/maze-module-generator/src-gen</arg>
              </applicationArgs>
              

              <executionEnvironment>JavaSE-21</executionEnvironment>
              <jvmArgs>
                <arg>-Dfile.encoding=UTF-8</arg>
              </jvmArgs>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <dependencies>
                <!-- Standard Eclipse Dependencies -->
                <dependency><type>eclipse-plugin</type><artifactId>org.eclipse.osgi</artifactId></dependency>
                <dependency><type>eclipse-plugin</type><artifactId>org.eclipse.equinox.app</artifactId></dependency>
                <dependency><type>eclipse-plugin</type><artifactId>org.eclipse.core.runtime</artifactId></dependency>
                
                <!-- EMF Dependencies -->
                <dependency><type>eclipse-plugin</type><artifactId>org.eclipse.emf.ecore</artifactId></dependency>
                <dependency><type>eclipse-plugin</type><artifactId>org.eclipse.emf.ecore.xmi</artifactId></dependency>
                <dependency><type>eclipse-plugin</type><artifactId>org.eclipse.emf.common</artifactId></dependency>

                <!-- FreeMarker-based Generator -->
                <dependency>
                    <type>eclipse-plugin</type>
                  <artifactId>maze-generator.freemarker</artifactId>
                    <version>0.0.0</version>
                </dependency>

                <!-- Domain Models -->
                <dependency>
                    <type>eclipse-plugin</type>
                    <artifactId>main.game.maze.difficulties</artifactId>
                    <version>0.0.0</version>
                </dependency>
                <dependency>
                    <type>eclipse-plugin</type>
                    <artifactId>main.game.maze.opponents</artifactId>
                    <version>0.0.0</version>
                </dependency>
                <dependency>
                    <type>eclipse-plugin</type>
                    <artifactId>main.game.maze.mazeworld</artifactId>
                    <version>0.0.0</version>
                </dependency>
                <dependency>
                    <type>eclipse-plugin</type>
                    <artifactId>main.game.maze.walls</artifactId>
                    <version>0.0.0</version>
                </dependency>
                <dependency>
                    <type>eclipse-plugin</type>
                    <artifactId>main.game.maze.behaviour</artifactId>
                    <version>0.0.0</version>
                </dependency>
            </dependencies>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
