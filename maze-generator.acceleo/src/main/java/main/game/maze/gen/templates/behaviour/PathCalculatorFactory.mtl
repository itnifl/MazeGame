package main.game.maze.generated;

import java.util.logging.Logger;

import main.game.maze.behaviour.*;

/**
 * Generated factory for PathCalculator instances.
 * Provides type-safe creation of pathfinding algorithms.
 * 
 * @generated from movements.ecore
 */
public final class PathCalculatorFactory {

    private static final Logger LOGGER = Logger.getLogger(PathCalculatorFactory.class.getName());

    private PathCalculatorFactory() { /* utility class */ }

    /**
     * Enumeration of available pathfinding algorithms.
     */
    public enum Algorithm {
        ASTAR("AstarPathCalculator"),
        DIJKSTRA("DijkstraPathCalculator"),
        LOCAL("LocalPathCalculator");

        private final String className;

        Algorithm(String className) {
            this.className = className;
        }

        public String getClassName() {
            return className;
        }
    }

    /**
     * Creates a PathCalculator of the specified type.
     * 
     * @param algorithm the pathfinding algorithm to use
     * @return a new PathCalculator instance
     */
    public static PathCalculator create(Algorithm algorithm) {
        return switch (algorithm) {
            case ASTAR -> BehaviourFactory.eINSTANCE.createAstarPathCalculator();
            case DIJKSTRA -> BehaviourFactory.eINSTANCE.createDijkstraPathCalculator();
            case LOCAL -> BehaviourFactory.eINSTANCE.createLocalPathCalculator();
        };
    }

    /**
     * Creates a PathCalculator by class name (for dynamic/reflective use).
     * 
     * @param className the PathCalculator class name
     * @return a new PathCalculator instance or null if unknown
     */
    public static PathCalculator createByName(String className) {
        if (className == null) return null;
        
        return switch (className) {
            case "AstarPathCalculator" -> BehaviourFactory.eINSTANCE.createAstarPathCalculator();
            case "DijkstraPathCalculator" -> BehaviourFactory.eINSTANCE.createDijkstraPathCalculator();
            case "LocalPathCalculator" -> BehaviourFactory.eINSTANCE.createLocalPathCalculator();
            default -> {
                LOGGER.warning("Unknown PathCalculator type: " + className);
                yield null;
            }
        };
    }

    /**
     * Gets the algorithm type from an existing PathCalculator.
     * 
     * @param calculator the PathCalculator instance
     * @return the Algorithm enum value
     */
    public static Algorithm getAlgorithm(PathCalculator calculator) {
        if (calculator == null) return Algorithm.LOCAL;
        
        return switch (calculator.eClass().getName()) {
            case "AstarPathCalculator" -> Algorithm.ASTAR;
            case "DijkstraPathCalculator" -> Algorithm.DIJKSTRA;
            case "LocalPathCalculator" -> Algorithm.LOCAL;
            default -> Algorithm.LOCAL;
        };
    }

    /**
     * Configures a PathCalculator with default settings.
     * 
     * @param calculator the calculator to configure
     * @param distanceMethod the distance calculation method to use
     */
    public static void configure(PathCalculator calculator, DistanceMethod distanceMethod) {
        if (calculator == null) return;
        calculator.setDistancemethod(distanceMethod);
    }

    // =========================================================================
    // Algorithm characteristics (generated from model)
    // =========================================================================

    /**
     * Gets all available algorithm names.
     * @return array of PathCalculator class names
     */
    public static String['['/][']'/] getAvailableAlgorithms() {
        return new String['['/][']'/] {
            "AstarPathCalculator",
            "DijkstraPathCalculator",
            "LocalPathCalculator"
        };
    }

    /**
     * Checks if an algorithm supports optimal pathfinding.
     * @param algorithm the algorithm
     * @return true if algorithm finds optimal paths
     */
    public static boolean isOptimal(Algorithm algorithm) {
        return switch (algorithm) {
            case ASTAR -> true;
            case DIJKSTRA -> true;
            case LOCAL -> false;
        };
    }

    /**
     * Gets the computational complexity class.
     * @param algorithm the algorithm
     * @return complexity description
     */
    public static String getComplexity(Algorithm algorithm) {
        return switch (algorithm) {
            case ASTAR -> "O(E log V) with heuristic";
            case DIJKSTRA -> "O(E log V)";
            case LOCAL -> "O(1) - greedy";
        };
    }
}
