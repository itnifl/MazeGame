package main.game.maze.generated;

/**
 * Generated opponent registry with all character types.
 * @generated from opponents.ecore
 */
public class OpponentRegistry {
    public static final String GAME_NAME = "[root.name/]";
    
    /**
     * Lists all registered enemies to stdout.
     */
    public static void listEnemies() {
        [for (enemy : CharacterType | root.characterTypes)]
        System.out.println("Enemy: [enemy.displayName/] (Health: [enemy.health/])");
        [/for]
    }

    /**
     * Gets the count of registered enemy types.
     * @return number of character types in model
     */
    public static int getEnemyTypeCount() {
        return [root.characterTypes->size()/];
    }

    /**
     * Gets all enemy type names.
     * @return array of display names
     */
    public static String['['/][']'/] getEnemyTypeNames() {
        return new String['['/][']'/] {
            [for (enemy : CharacterType | root.characterTypes) separator(', ')]"[enemy.displayName/]"[/for]
        };
    }
}
