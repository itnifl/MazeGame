[**
 * Main Acceleo generation entry point for MazeGame.
 * 
 * This module orchestrates Model-Driven Code Generation across all domains:
 * - Opponents (CharacterType hierarchy)
 * - Difficulties (Difficulty configuration)
 * 
 * Generated code eliminates hand-written switch statements and instanceof checks.
 * Adding a new model element (e.g., new enemy type) automatically updates all
 * generated dispatchers, factories, and configurators.
 * 
 * @author MazeGame MDE Pipeline
 * @generated
 */]
[module Generate('http://main.game.maze/opponents', 'http://main.game.maze/difficulties')]

