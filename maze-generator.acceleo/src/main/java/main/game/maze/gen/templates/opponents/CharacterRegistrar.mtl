[comment encoding = UTF-8 /]
[module CharacterRegistrar('http://main.game.maze/opponents', 'http://main.game.maze/difficulties')]

[comment]
  Generates a CharacterRegistrar that handles registration of all CharacterType
  subclasses without instanceof chains. Adding a new enemy type to the model
  automatically adds a case here.
[/comment]

[template public generateCharacterRegistrar(model : OpponentModel)]
[comment @main /]
[file ('main/game/maze/generated/CharacterRegistrar.java', false, 'UTF-8')]
package main.game.maze.generated;

import java.util.concurrent.ThreadLocalRandom;
import java.util.function.BiConsumer;
import java.util.logging.Level;
import java.util.logging.Logger;

import javafx.application.Platform;
import javafx.scene.Node;

import main.game.maze.opponents.*;
import main.game.maze.characters.*;
import main.game.maze.GameController;

/**
 * Generated character registrar that dispatches to type-specific handlers.
 * Eliminates instanceof chains by using switch on eClass name.
 * 
 * @generated from opponents.ecore
 */
public final class CharacterRegistrar {

    private static final Logger LOGGER = Logger.getLogger(CharacterRegistrar.class.getName());

    private CharacterRegistrar() { /* utility class */ }

    /**
     * Functional interface for character registration.
     */
    @FunctionalInterface
    public interface CharacterRegistrationHandler {
        void register(GameController controller, CharacterType character, double x, double y, Node graphics);
    }

    /**
     * Registers a character with the game controller based on its type.
     * 
     * @param controller the game controller
     * @param character the character to register
     * @param spawnX spawn X coordinate
     * @param spawnY spawn Y coordinate  
     * @param graphicsFactory function to create graphics node for the character
     */
    public static void register(
            GameController controller,
            CharacterType character,
            double spawnX,
            double spawnY,
            java.util.function.Function<CharacterType, Node> graphicsFactory) {
        
        if (controller == null || character == null) {
            LOGGER.warning("Cannot register: controller or character is null");
            return;
        }

        Platform.runLater(() -> {
            try {
                Node graphics = graphicsFactory.apply(character);
                graphics.setLayoutX(spawnX);
                graphics.setLayoutY(spawnY);

                String typeName = character.eClass().getName();
                
                switch (typeName) {
[for (charType : CharacterType | model.characterTypes->collect(c | c.eClass())->asSet())]
                    case "[charType.eClass().name/]" -> register[charType.eClass().name/](controller, character, graphics, spawnX, spawnY);
[/for]
                    // Fallback for types defined in model but not in current instance
                    case "Zombie" -> registerZombie(controller, character, graphics, spawnX, spawnY);
                    case "Ghost" -> registerGhost(controller, character, graphics, spawnX, spawnY);
                    case "PumpkinBomber" -> registerPumpkinBomber(controller, character, graphics, spawnX, spawnY);
                    default -> LOGGER.log(Level.WARNING, "Unknown character type: {0}", typeName);
                }
            } catch (Exception e) {
                LOGGER.log(Level.SEVERE, "Failed to register character", e);
            }
        });
    }

    // =========================================================================
    // Generated registration methods for each CharacterType subclass
    // =========================================================================

    private static void registerZombie(GameController controller, CharacterType character, Node graphics, double x, double y) {
        Zombie zombie = (Zombie) character;
        ZombieCharacter zombieCharacter = new ZombieCharacter(graphics, x, y, zombie);
        controller.registerComputerCharacter(zombieCharacter, graphics);
        LOGGER.log(Level.FINE, "Registered Zombie: {0}", zombie.getDisplayName());
    }

    private static void registerGhost(GameController controller, CharacterType character, Node graphics, double x, double y) {
        Ghost ghost = (Ghost) character;
        GhostCharacter ghostCharacter = new GhostCharacter(graphics, x, y, ghost);
        controller.registerComputerCharacter(ghostCharacter, graphics);
        LOGGER.log(Level.FINE, "Registered Ghost: {0}", ghost.getDisplayName());
    }

    private static void registerPumpkinBomber(GameController controller, CharacterType character, Node graphics, double x, double y) {
        PumpkinBomber bomber = (PumpkinBomber) character;
        PumpkinBomberCharacter bomberCharacter = new PumpkinBomberCharacter(graphics, x, y, bomber);
        // TODO: controller.registerComputerCharacter(bomberCharacter, graphics);
        LOGGER.log(Level.FINE, "Registered PumpkinBomber: {0}", bomber.getDisplayName());
    }

    // =========================================================================
    // Character type enumeration (generated from model)
    // =========================================================================

    /**
     * Gets all character type names defined in the model.
     * @return array of type names
     */
    public static String['['/][']'/] getKnownCharacterTypes() {
        return new String['['/][']'/] {
            "Zombie",
            "Ghost", 
            "PumpkinBomber"
        };
    }
}
