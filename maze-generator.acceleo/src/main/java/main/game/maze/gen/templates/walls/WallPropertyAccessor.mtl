[module WallPropertyAccessor('http://main.game.maze/walls')]

[comment]
  Generates a unified property accessor for wall materials.
  Provides type-safe access to all wall properties without reflection.
[/comment]

[template public generateWallPropertyAccessor(pkg : ecore::EPackage)]
