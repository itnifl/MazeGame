[file ('main/game/maze/generated/WallPropertyAccessor.java', false, 'UTF-8')]
package main.game.maze.generated;

import java.util.Optional;
import java.util.function.Function;
import java.util.logging.Logger;

import main.game.maze.walls.WallMaterial;
import main.game.maze.walls.WallMaterialBaseType;
import main.game.maze.walls.WallsFactory;

/**
 * Generated property accessor for WallMaterial instances.
 * Provides type-safe property access and defaults.
 * 
 * @generated from walls.ecore
 */
public final class WallPropertyAccessor {

    private static final Logger LOGGER = Logger.getLogger(WallPropertyAccessor.class.getName());

    private WallPropertyAccessor() { /* utility class */ }

    /**
     * All available wall property names.
     */
    public enum Property {
        WALL_BASE_TYPE("wallBaseType"),
        DISPLAY_NAME("displayName"),
        BREAKABLE("breakable"),
        HIT_POINTS("hitPoints"),
        ID("id"),
        BASE_IMAGE("baseImage");

        private final String attributeName;

        Property(String attributeName) {
            this.attributeName = attributeName;
        }

        public String getAttributeName() {
            return attributeName;
        }
    }

    // =========================================================================
    // Type-safe Getters (generated from EStructuralFeatures)
    // =========================================================================

    /**
     * Gets the wall base type, with default.
     * @param material the wall material (may be null)
     * @return base type or STEEL default
     */
    public static WallMaterialBaseType getBaseType(WallMaterial material) {
        if (material == null) return WallMaterialBaseType.STEEL;
        WallMaterialBaseType type = material.getWallBaseType();
        return type != null ? type : WallMaterialBaseType.STEEL;
    }

    /**
     * Gets the display name, with default.
     * @param material the wall material (may be null)
     * @return display name or "Unknown Wall"
     */
    public static String getDisplayName(WallMaterial material) {
        if (material == null) return "Unknown Wall";
        String name = material.getDisplayName();
        return (name != null && !name.isEmpty()) ? name : "Unknown Wall";
    }

    /**
     * Gets the breakable flag.
     * @param material the wall material (may be null)
     * @return true if breakable, false otherwise
     */
    public static boolean isBreakable(WallMaterial material) {
        if (material == null) return false;
        return material.isBreakable();
    }

    /**
     * Gets the hit points.
     * @param material the wall material (may be null)
     * @return hit points or 0
     */
    public static int getHitPoints(WallMaterial material) {
        if (material == null) return 0;
        return material.getHitPoints();
    }

    /**
     * Gets the wall ID.
     * @param material the wall material (may be null)
     * @return ID string or empty
     */
    public static String getId(WallMaterial material) {
        if (material == null) return "";
        String id = material.getId();
        return id != null ? id : "";
    }

    /**
     * Gets the base image path.
     * @param material the wall material (may be null)
     * @return image path or default
     */
    public static String getBaseImage(WallMaterial material) {
        if (material == null) return "/main/game/maze/baseWall.png";
        String img = material.getBaseImage();
        return (img != null && !img.isEmpty()) ? img : "/main/game/maze/baseWall.png";
    }

    // =========================================================================
    // Property Builder (generated from EClass structure)
    // =========================================================================

    /**
     * Builder for creating WallMaterial instances with defaults.
     */
    public static class Builder {
        private WallMaterialBaseType baseType = WallMaterialBaseType.STEEL;
        private String displayName = "Wall";
        private boolean breakable = false;
        private int hitPoints = 0;
        private String baseImage = "/main/game/maze/baseWall.png";

        public Builder baseType(WallMaterialBaseType type) {
            this.baseType = type;
            return this;
        }

        public Builder displayName(String name) {
            this.displayName = name;
            return this;
        }

        public Builder breakable(boolean breakable) {
            this.breakable = breakable;
            return this;
        }

        public Builder hitPoints(int hp) {
            this.hitPoints = hp;
            return this;
        }

        public Builder baseImage(String image) {
            this.baseImage = image;
            return this;
        }

        /**
         * Builds a WallMaterial with the configured properties.
         * @return new WallMaterial instance
         */
        public WallMaterial build() {
            WallMaterial material = WallsFactory.eINSTANCE.createWallMaterial();
            material.setWallBaseType(baseType);
            material.setDisplayName(displayName);
            // Note: breakable is transient/derived in model
            material.setHitPoints(hitPoints);
            material.setBaseImage(baseImage);
            return material;
        }
    }

    /**
     * Creates a new Builder.
     * @return fresh builder instance
     */
    public static Builder builder() {
        return new Builder();
    }

    // =========================================================================
    // Factory Presets (generated from WallMaterialBaseType enum)
    // =========================================================================

    /**
     * Creates a standard glass wall.
     */
    public static WallMaterial createGlassWall() {
        return builder()
            .baseType(WallMaterialBaseType.GLASS)
            .displayName("Glass Wall")
            .breakable(true)
            .hitPoints(10)
            .baseImage("/main/game/maze/textures/wall_glass.png")
            .build();
    }

    /**
     * Creates a standard dirt wall.
     */
    public static WallMaterial createDirtWall() {
        return builder()
            .baseType(WallMaterialBaseType.DIRT)
            .displayName("Dirt Wall")
            .breakable(true)
            .hitPoints(25)
            .baseImage("/main/game/maze/textures/wall_dirt.png")
            .build();
    }

    /**
     * Creates a standard wood wall.
     */
    public static WallMaterial createWoodWall() {
        return builder()
            .baseType(WallMaterialBaseType.WOOD)
            .displayName("Wood Wall")
            .breakable(true)
            .hitPoints(40)
            .baseImage("/main/game/maze/textures/wall_wood.png")
            .build();
    }

    /**
     * Creates a standard stone wall.
     */
    public static WallMaterial createStoneWall() {
        return builder()
            .baseType(WallMaterialBaseType.STONE)
            .displayName("Stone Wall")
            .breakable(true)
            .hitPoints(75)
            .baseImage("/main/game/maze/textures/wall_stone.png")
            .build();
    }

    /**
     * Creates a standard steel wall (unbreakable).
     */
    public static WallMaterial createSteelWall() {
        return builder()
            .baseType(WallMaterialBaseType.STEEL)
            .displayName("Steel Wall")
            .breakable(false)
            .hitPoints(0)
            .baseImage("/main/game/maze/textures/wall_steel.png")
            .build();
    }

    /**
     * Creates a wall preset by base type.
     * @param baseType the material type
     * @return configured wall material
     */
    public static WallMaterial createByType(WallMaterialBaseType baseType) {
        if (baseType == null) return createSteelWall();
        
        return switch (baseType) {
            case GLASS -> createGlassWall();
            case DIRT -> createDirtWall();
            case WOOD -> createWoodWall();
            case STONE -> createStoneWall();
            case STEEL -> createSteelWall();
        };
    }

    // =========================================================================
    // Validation (generated from OCL constraints)
    // =========================================================================

    /**
     * Validates a WallMaterial against model constraints.
     * OCL: (breakable = false implies hitPoints = 0) and (breakable = true implies hitPoints > 0)
     * 
     * @param material the material to validate
     * @return validation result
     */
    public static ValidationResult validate(WallMaterial material) {
        if (material == null) {
            return new ValidationResult(false, "Material is null");
        }

        boolean breakable = material.isBreakable();
        int hitPoints = material.getHitPoints();

        // OCL constraint: ValidHitPoints
        if (!breakable && hitPoints != 0) {
            return new ValidationResult(false, 
                "Non-breakable wall must have hitPoints = 0, but has " + hitPoints);
        }
        if (breakable && hitPoints <= 0) {
            return new ValidationResult(false,
                "Breakable wall must have hitPoints > 0, but has " + hitPoints);
        }

        return new ValidationResult(true, "Valid");
    }

    public record ValidationResult(boolean valid, String message) {}
}
