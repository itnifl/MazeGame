[comment encoding = UTF-8 /]
[module CharacterAttributeSetter('http://main.game.maze/opponents', 'http://main.game.maze/difficulties')]

[comment]
  Generates attribute setters that apply difficulty multipliers to characters.
  Handles attackDamage, speed, and other attributes per character type.
[/comment]

[template public generateCharacterAttributeSetter(model : OpponentModel)]
[comment @main /]
[file ('main/game/maze/generated/CharacterAttributeSetter.java', false, 'UTF-8')]
package main.game.maze.generated;

import main.game.maze.opponents.*;
import main.game.maze.difficulties.Difficulty;

/**
 * Generated attribute setter that applies difficulty multipliers to characters.
 * Eliminates instanceof chains for damage/speed modifications.
 * 
 * @generated from opponents.ecore + difficulty-module.ecore
 */
public final class CharacterAttributeSetter {

    private CharacterAttributeSetter() { /* utility class */ }

    /**
     * Applies difficulty-based multipliers to a character's attributes.
     * 
     * @param character the character to modify
     * @param speedMultiplier difficulty speed multiplier
     * @param damageMultiplier difficulty damage multiplier
     * @param instantDeath whether damage should be lethal
     */
    public static void applyDifficultyMultipliers(
            CharacterType character,
            double speedMultiplier,
            double damageMultiplier,
            boolean instantDeath) {
        
        if (character == null) return;

        // Apply speed multiplier (common to all CharacterTypes)
        character.setSpeed(character.getSpeed() * speedMultiplier);

        // Apply damage multiplier based on character type
        String typeName = character.eClass().getName();
        
        switch (typeName) {
            case "Zombie" -> applyZombieDamage((Zombie) character, damageMultiplier, instantDeath);
            case "Ghost" -> applyGhostDamage((Ghost) character, damageMultiplier, instantDeath);
            case "PumpkinBomber" -> applyRangedEnemyDamage((RangedEnemy) character, damageMultiplier, instantDeath);
            default -> { /* No damage attribute for this type */ }
        }
    }

    /**
     * Convenience method using DifficultySettings record.
     */
    public static void applyDifficultyMultipliers(
            CharacterType character,
            DifficultyConfigurator.DifficultySettings settings) {
        
        applyDifficultyMultipliers(
            character,
            settings.speedMultiplier(),
            settings.damageMultiplier(),
            settings.instantDeath()
        );
    }

    // =========================================================================
    // Type-specific damage application methods
    // =========================================================================

    private static void applyZombieDamage(Zombie zombie, double multiplier, boolean instantDeath) {
        if (instantDeath) {
            zombie.setAttackDamage(Integer.MAX_VALUE);
        } else {
            zombie.setAttackDamage(Math.max(1, (int) Math.round(zombie.getAttackDamage() * multiplier)));
        }
    }

    private static void applyGhostDamage(Ghost ghost, double multiplier, boolean instantDeath) {
        if (instantDeath) {
            ghost.setAttackDamage(Integer.MAX_VALUE);
        } else {
            ghost.setAttackDamage(Math.max(1, (int) Math.round(ghost.getAttackDamage() * multiplier)));
        }
    }

    private static void applyRangedEnemyDamage(RangedEnemy ranged, double multiplier, boolean instantDeath) {
        if (instantDeath) {
            ranged.setAttackDamage(Integer.MAX_VALUE);
        } else {
            ranged.setAttackDamage(Math.max(1, (int) Math.round(ranged.getAttackDamage() * multiplier)));
        }
    }

    // =========================================================================
    // Attribute accessors (generated from model attributes)
    // =========================================================================

    /**
     * Gets the attack damage for any character type that has it.
     * @param character the character
     * @return attack damage or 0 if type doesn't have attackDamage
     */
    public static int getAttackDamage(CharacterType character) {
        if (character == null) return 0;
        
        return switch (character.eClass().getName()) {
            case "Zombie" -> ((Zombie) character).getAttackDamage();
            case "Ghost" -> ((Ghost) character).getAttackDamage();
            case "PumpkinBomber" -> ((RangedEnemy) character).getAttackDamage();
            default -> 0;
        };
    }

    /**
     * Checks if a character type has ranged attack capability.
     * @param character the character
     * @return true if character is a RangedEnemy
     */
    public static boolean isRangedEnemy(CharacterType character) {
        if (character == null) return false;
        return character instanceof RangedEnemy;
    }
}
[/file]
[/template]
