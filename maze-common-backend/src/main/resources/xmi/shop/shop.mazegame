/*
 * The shop between levels (issue #164), written in the MazeGame DSL (Xtext). This is the source of shop.xmi:
 * MazeDslGenerator.shopXmi renders it with the FreeMarker template shop.xmi.ftlx into the instance of shop.ecore that
 * the game loads, and MazeDslShopTest checks that the shipped shop.xmi says the same. See docs/level-authoring.md.
 *
 * The player pays with their score (the price is taken from the score carried into the next level).
 * Three cheap, weak items (sold from the first shop); four medium items (from the shop after level 3); three
 * expensive, strong items (from the shop after level 5).
 * The weapons themselves (sprite, sounds, damage, range) are defined in xmi/items/items.xmi.
 */
game MazeGameShop {

    shop {
        // only weak items until level 3; medium items from the shop between levels 3 and 4,
        // strong items from the shop between levels 5 and 6
        unlock CHEAP fromLevel 2
        unlock MEDIUM fromLevel 4
        unlock EXPENSIVE fromLevel 6

        // cheap
        item SHIELD_BOOST "Extra long shield" tier CHEAP price 2000 factor 3.0
            description "Next level: every shield you pick up lasts three times as long"
        item FLAME_BOOST "Extra long flames" tier CHEAP price 2000 factor 1.6
            description "Next level: your bombs reach further and do more damage"
        item GRENADE "Grenades" tier CHEAP price 2000 amount 5
            description "Thrown ahead of you, they go off after a moment"

        // medium
        item PLASMA_GRENADE "Plasma grenades" tier MEDIUM price 10000 amount 3
            description "Thrown ahead of you: a wider, much stronger blast"
        item BUNKER_BUSTER "Bunker buster rockets" tier MEDIUM price 10000 amount 3
            description "Goes through several walls, wrecks walls and towers"
        item FAT_BOMB "Fat bomb" tier MEDIUM price 10000 amount 1
            description "A planted bomb with huge flames - run!"
        item EXTRA_LIFE "Extra life" tier MEDIUM price 10000 amount 3
            description "Use it like a weapon to fill your health bar; three of them"

        // expensive
        item NUKE_GRENADE "Small nuclear grenades" tier EXPENSIVE price 40000 amount 2
            description "A nuclear blast through walls, shown as a mushroom cloud"
        item AIRSTRIKE "Airstrike" tier EXPENSIVE price 40000 amount 1
            description "Bombers carpet bomb the centre of the maze"
        item INFANTRY_STRIKE "Infantry strike" tier EXPENSIVE price 40000 amount 1
            description "Ten soldiers land and hunt down every enemy"
    }
}
