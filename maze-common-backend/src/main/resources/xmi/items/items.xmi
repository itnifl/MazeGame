<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pickups that spawn during play. Shared by the JavaFX and libGDX frontends (PickupCatalogLoader).
  Caps follow the board size, which follows difficulty: Easy 800 px wide, Normal 1100, Hard 1400.
-->
<items:PickupModel
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:items="http://main.game.maze/items"
    spawnIntervalSeconds="3.0"
    itemSizeFactor="1.0"
    minDistanceFromPlayer="80.0">

  <caps minBoardWidth="0" maxItems="5"/>
  <caps minBoardWidth="1100" maxItems="10"/>
  <caps minBoardWidth="1400" maxItems="15"/>

  <items kind="BOMB" displayName="Bomb"
      sprite="/main/game/maze/pickups/bomb.png"
      pickupSound="/main/game/maze/sounds/pickup-bomb.wav"
      spawnWeight="3" amount="1"/>

  <items kind="LASER_RIFLE" displayName="Laser rifle"
      sprite="/main/game/maze/pickups/laser-rifle.png"
      pickupSound="/main/game/maze/sounds/pickup-laser.wav"
      useSound="/main/game/maze/sounds/laser-fire.wav"
      spawnWeight="3" amount="5" damage="60" range="600.0"/>

  <items kind="SLEDGEHAMMER" displayName="Sledgehammer"
      sprite="/main/game/maze/pickups/sledgehammer.png"
      pickupSound="/main/game/maze/sounds/pickup-sledgehammer.wav"
      useSound="/main/game/maze/sounds/sledgehammer-swing.wav"
      spawnWeight="3" amount="5" damage="120" range="58.0"/>

  <items kind="SHIELD" displayName="Power shield"
      sprite="/main/game/maze/pickups/shield.png"
      pickupSound="/main/game/maze/sounds/pickup-shield.wav"
      spawnWeight="3" durationSeconds="5.0"/>

  <items kind="HEART" displayName="Small heart"
      sprite="/main/game/maze/pickups/heart.png"
      pickupSound="/main/game/maze/sounds/pickup-heart.wav"
      spawnWeight="3" amount="20"/>

  <!-- rare: one in sixteen items -->
  <items kind="EXTRA_LIFE" displayName="Extra life"
      sprite="/main/game/maze/pickups/extra-life.png"
      pickupSound="/main/game/maze/sounds/pickup-extra-life.wav"
      spawnWeight="1" amount="1"/>

  <!-- never spawns on its own (spawnWeight 0): dropped where a zombie sergeant is killed -->
  <items kind="GATLING_GUN" displayName="Gatling gun"
      sprite="/main/game/maze/pickups/gatling-gun.png"
      pickupSound="/main/game/maze/sounds/pickup-gatling.wav"
      useSound="/main/game/maze/sounds/gatling-burst.wav"
      spawnWeight="0" amount="5" damage="45" range="450.0"/>

  <!-- never spawns: the gift of the last life (levels.xmi lastLifeGift). Charges for 2 seconds, then one beam strong enough to
       blow up a guard tower (1500 hit points) in a single shot; six shots. -->
  <items kind="PULSE_CANNON" displayName="Pulse beam cannon"
      sprite="/main/game/maze/pickups/pulse-cannon.png"
      pickupSound="/main/game/maze/sounds/pickup-pulse.wav"
      useSound="/main/game/maze/sounds/pulse-fire.wav"
      chargeSound="/main/game/maze/sounds/pulse-charge.wav"
      spawnWeight="0" amount="6" damage="12000" range="1200.0" chargeSeconds="2.0"/>

  <!-- The shop weapons (xmi/shop/shop.xmi): never lying about the maze (spawnWeight 0), bought between levels and used
       like the other weapons (Tab selects, Space uses). The shop decides how many one purchase gives. -->

  <!-- thrown along the facing up to `range` (they land short of a wall), go off after `fuseSeconds` -->
  <items kind="GRENADE" displayName="Grenade"
      sprite="/main/game/maze/pickups/grenade.png"
      pickupSound="/main/game/maze/sounds/shop-buy.wav"
      useSound="/main/game/maze/sounds/grenade-throw.wav"
      spawnWeight="0" amount="4" damage="160" range="240.0" blastRadius="120.0" fuseSeconds="1.2"/>

  <items kind="PLASMA_GRENADE" displayName="Plasma grenade"
      sprite="/main/game/maze/pickups/plasma-grenade.png"
      pickupSound="/main/game/maze/sounds/shop-buy.wav"
      useSound="/main/game/maze/sounds/grenade-throw.wav"
      spawnWeight="0" amount="3" damage="420" range="260.0" blastRadius="180.0" fuseSeconds="1.2"/>

  <!-- the strongest and widest thrown blast: it reaches back to the thrower, so throw it far -->
  <items kind="NUKE_GRENADE" displayName="Small nuclear grenade"
      sprite="/main/game/maze/pickups/nuke-grenade.png"
      pickupSound="/main/game/maze/sounds/shop-buy.wav"
      useSound="/main/game/maze/sounds/grenade-throw.wav"
      spawnWeight="0" amount="2" damage="2400" range="300.0" blastRadius="420.0" fuseSeconds="2.0"/>

  <!-- a rocket along the facing: piercePower goes through walls (and towers) in the way, then a blast at the end -->
  <items kind="BUNKER_BUSTER" displayName="Bunker buster rocket"
      sprite="/main/game/maze/pickups/bunker-buster.png"
      pickupSound="/main/game/maze/sounds/shop-buy.wav"
      useSound="/main/game/maze/sounds/rpg-launch.wav"
      spawnWeight="0" amount="3" damage="500" range="900.0" blastRadius="140.0" piercePower="9000"/>

  <!-- planted like the bomb: much longer flames and much more damage -->
  <items kind="FAT_BOMB" displayName="Fat bomb"
      sprite="/main/game/maze/pickups/fat-bomb.png"
      pickupSound="/main/game/maze/sounds/shop-buy.wav"
      spawnWeight="0" amount="2" damage="700" blastRadius="520.0" fuseSeconds="3.0"/>

  <!-- `units` bombs fall at random within `range` of the approximate centre of the maze, over `durationSeconds`,
       starting `fuseSeconds` after the call; they never hurt the player who called them in -->
  <items kind="AIRSTRIKE" displayName="Airstrike"
      sprite="/main/game/maze/pickups/airstrike.png"
      pickupSound="/main/game/maze/sounds/shop-buy.wav"
      useSound="/main/game/maze/sounds/airstrike-siren.wav"
      spawnWeight="0" amount="1" damage="600" range="280.0" blastRadius="170.0" fuseSeconds="2.5"
      durationSeconds="3.5" units="16"/>

  <!-- `units` soldiers arrive in a random area and hunt every enemy for `durationSeconds`; each round does `damage`
       to an enemy in sight within `range` -->
  <items kind="INFANTRY_STRIKE" displayName="Infantry strike"
      sprite="/main/game/maze/pickups/infantry-strike.png"
      pickupSound="/main/game/maze/sounds/shop-buy.wav"
      useSound="/main/game/maze/sounds/infantry-whistle.wav"
      spawnWeight="0" amount="1" damage="45" range="320.0" durationSeconds="45.0" units="10"/>

  <!-- "Extra life" in the shop: used like a weapon, it fills the health bar -->
  <items kind="LIFE_REFILL" displayName="Extra life (full health)"
      sprite="/main/game/maze/pickups/life-refill.png"
      pickupSound="/main/game/maze/sounds/shop-buy.wav"
      useSound="/main/game/maze/sounds/pickup-heart.wav"
      spawnWeight="0" amount="3"/>
</items:PickupModel>
