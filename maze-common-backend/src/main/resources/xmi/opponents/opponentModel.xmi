<?xml version="1.0" encoding="UTF-8"?>
<opponents:OpponentModel
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:opponents="http://main.game.maze/opponents"
    xmlns:diff="http://main.game.maze/difficulties" 
    name="MazeGame">
    <name>MazeGame</name>
  
  <selectedDifficulty
      xsi:type="diff:NormalDifficulty"
      href="../difficulties/difficulties.xmi#normal"/>
    <characterTypes xsi:type="opponents:Ghost">
      <id>ghost_weak_1</id>
      <displayName>Ghost Zombie</displayName>
      <enabled>true</enabled>
      <health>120</health>
      <speed>2</speed>
      <threatLevel>1.0</threatLevel>
      <attackDamage>1</attackDamage>
      <behavior>PATROL</behavior>
      <ImageBase>/main/game/maze/ghost1.png</ImageBase>
      <ImageTurnLeft>/main/game/maze/ghost1-left.png</ImageTurnLeft>
      <ImageTurnRight>/main/game/maze/ghost1-right.png</ImageTurnRight>
      <ImageTurnUp>/main/game/maze/ghost1.png</ImageTurnUp>
      <ImageTurnDown>/main/game/maze/ghost1.png</ImageTurnDown>
      <nonTangibilityEnergy>100.0</nonTangibilityEnergy>
    </characterTypes>

    <characterTypes xsi:type="opponents:Ghost">
      <id>ghost_medium_1</id>
      <displayName>Ghost Zombie</displayName>
      <enabled>true</enabled>
      <health>120</health>
      <speed>5</speed>
      <threatLevel>1.0</threatLevel>
      <attackDamage>2</attackDamage>
      <behavior>WANDER</behavior>
      <ImageBase>/main/game/maze/ghost2.png</ImageBase>
      <ImageTurnLeft>/main/game/maze/ghost2.png</ImageTurnLeft>
      <ImageTurnRight>/main/game/maze/ghost2.png</ImageTurnRight>
      <ImageTurnUp>/main/game/maze/ghost2.png</ImageTurnUp>
      <ImageTurnDown>/main/game/maze/ghost2.png</ImageTurnDown>
    </characterTypes>

    <characterTypes xsi:type="opponents:Ghost">
      <id>ghost_hard_1</id>
      <displayName>Ghost Zombie</displayName>
      <enabled>true</enabled>
      <health>120</health>
      <speed>1</speed>
      <threatLevel>3.0</threatLevel>
      <attackDamage>5</attackDamage>
      <behavior>WANDER</behavior>
      <ImageBase>/main/game/maze/ghost3.png</ImageBase>
      <ImageTurnLeft>/main/game/maze/ghost3.png</ImageTurnLeft>
      <ImageTurnRight>/main/game/maze/ghost3.png</ImageTurnRight>
      <ImageTurnUp>/main/game/maze/ghost3.png</ImageTurnUp>
      <ImageTurnDown>/main/game/maze/ghost3.png</ImageTurnDown>
    </characterTypes>

    <characterTypes xsi:type="opponents:Zombie">
      <id>zombie_weak_1</id>
      <displayName>Classic Zombie</displayName>
      <enabled>true</enabled>
      <health>120</health>
      <speed>0.8</speed>
      <threatLevel>1.0</threatLevel>
      <attackDamage>2</attackDamage>
      <behavior>PATROL</behavior>
      <animationFrameCount>3</animationFrameCount>
      <ImageBase>/main/game/maze/zombie1-down.png</ImageBase>
      <ImageTurnLeft>/main/game/maze/zombie1-left.png</ImageTurnLeft>
      <ImageTurnRight>/main/game/maze/zombie1-right.png</ImageTurnRight>
      <ImageTurnUp>/main/game/maze/zombie1-up.png</ImageTurnUp>
      <ImageTurnDown>/main/game/maze/zombie1-down.png</ImageTurnDown>
    </characterTypes>

    <characterTypes xsi:type="opponents:Zombie">
      <id>zombie_angry_1</id>
      <displayName>Angry Zombie</displayName>
      <enabled>true</enabled>
      <health>60</health>
      <speed>3</speed>
      <threatLevel>4.0</threatLevel>
      <attackDamage>4</attackDamage>
      <behavior>AGGRESSIVE</behavior>
      <animationFrameCount>3</animationFrameCount>
      <ImageBase>/main/game/maze/zombie2-down.png</ImageBase>
      <ImageTurnLeft>/main/game/maze/zombie2-left.png</ImageTurnLeft>
      <ImageTurnRight>/main/game/maze/zombie2-right.png</ImageTurnRight>
      <ImageTurnUp>/main/game/maze/zombie2-down.png</ImageTurnUp>
      <ImageTurnDown>/main/game/maze/zombie2-down.png</ImageTurnDown>
    </characterTypes>

    <characterTypes xsi:type="opponents:Zombie">
      <id>zombie_weak_2</id>
      <displayName>Classic Zombie</displayName>
      <enabled>true</enabled>
      <health>120</health>
      <speed>3</speed>
      <threatLevel>2</threatLevel>
      <attackDamage>1</attackDamage>
      <behavior>WANDER</behavior>
      <animationFrameCount>3</animationFrameCount>
      <ImageBase>/main/game/maze/zombie3-down.png</ImageBase>
      <ImageTurnLeft>/main/game/maze/zombie3-left.png</ImageTurnLeft>
      <ImageTurnRight>/main/game/maze/zombie3-right.png</ImageTurnRight>
      <ImageTurnUp>/main/game/maze/zombie3-up.png</ImageTurnUp>
      <ImageTurnDown>/main/game/maze/zombie3-down.png</ImageTurnDown>
    </characterTypes>

  <!-- Normal difficulty bomber: LOB type, medium threat -->
  <characterTypes xsi:type="opponents:PumpkinBomber">
    <id>pb_normal</id>
    <displayName>Pumpkin Bomber</displayName>
    <enabled>true</enabled>
    <health>80</health>
    <speed>1.2</speed>
    <threatLevel>5.0</threatLevel>
    <behavior>AGGRESSIVE</behavior>

    <attackDamage>8</attackDamage>
    <attackRange>320</attackRange>
    <attackCooldownMs>4000</attackCooldownMs>
    <projectileSpeed>220.0</projectileSpeed>
    <projectileType>LOB</projectileType>
    <splashRadius>52</splashRadius>
    <arcHeight>40.0</arcHeight>

    <projectileImage>/main/game/maze/projectiles/pumpkinbomber/pumpkin_lob_projectile.png</projectileImage>
    <explosionImage>/main/game/maze/pumpkin-explode.png</explosionImage>
    <explosionSound>/main/game/maze/error.wav</explosionSound>

    <ImageBase>/main/game/maze/pumpkinbomber.png</ImageBase>
    <ImageTurnLeft>/main/game/maze/pumpkinbomber.png</ImageTurnLeft>
    <ImageTurnRight>/main/game/maze/pumpkinbomber.png</ImageTurnRight>
    <ImageTurnUp>/main/game/maze/pumpkinbomber.png</ImageTurnUp>
    <ImageTurnDown>/main/game/maze/pumpkinbomber.png</ImageTurnDown>
  </characterTypes>

  <!-- Hard difficulty elite bomber: STRAIGHT type, higher threat -->
  <characterTypes xsi:type="opponents:PumpkinBomber">
    <id>pb_hard</id>
    <displayName>Pumpkin Bomber Elite</displayName>
    <enabled>true</enabled>
    <health>120</health>
    <speed>1.8</speed>
    <threatLevel>8.0</threatLevel>
    <behavior>AGGRESSIVE</behavior>

    <attackDamage>12</attackDamage>
    <attackRange>380</attackRange>
    <attackCooldownMs>3000</attackCooldownMs>
    <projectileSpeed>280.0</projectileSpeed>
    <projectileType>STRAIGHT</projectileType>
    <splashRadius>0</splashRadius>
    <arcHeight>0.0</arcHeight>

    <projectileImage>/main/game/maze/projectiles/pumpkinbomber/pumpkin_straight_projectile.png</projectileImage>
    <explosionImage>/main/game/maze/pumpkin-explode.png</explosionImage>
    <explosionSound>/main/game/maze/error.wav</explosionSound>

    <ImageBase>/main/game/maze/pumpkinbomber.png</ImageBase>
    <ImageTurnLeft>/main/game/maze/pumpkinbomber.png</ImageTurnLeft>
    <ImageTurnRight>/main/game/maze/pumpkinbomber.png</ImageTurnRight>
    <ImageTurnUp>/main/game/maze/pumpkinbomber.png</ImageTurnUp>
    <ImageTurnDown>/main/game/maze/pumpkinbomber.png</ImageTurnDown>
  </characterTypes>

  <!-- Disabled zero-threat entry kept to exercise threat-floor logic in RuntimeVisualModelLoader (DO NOT DELETE) -->
  <characterTypes xsi:type="opponents:PumpkinBomber">
    <id>pb_threat_floor_fixture</id>
    <displayName>PumpkinBomber Threat Floor Fixture</displayName>
    <enabled>false</enabled>
    <health>1</health>
    <speed>0</speed>
    <threatLevel>0.0</threatLevel>
    <attackDamage>1</attackDamage>
    <attackRange>1</attackRange>
    <attackCooldownMs>99999</attackCooldownMs>
    <projectileSpeed>1.0</projectileSpeed>
    <projectileType>STRAIGHT</projectileType>
    <splashRadius>0</splashRadius>
    <arcHeight>0.0</arcHeight>
    <ImageBase>/main/game/maze/pumpkinbomber.png</ImageBase>
    <ImageTurnLeft>/main/game/maze/pumpkinbomber.png</ImageTurnLeft>
    <ImageTurnRight>/main/game/maze/pumpkinbomber.png</ImageTurnRight>
    <ImageTurnUp>/main/game/maze/pumpkinbomber.png</ImageTurnUp>
    <ImageTurnDown>/main/game/maze/pumpkinbomber.png</ImageTurnDown>
  </characterTypes>

</opponents:OpponentModel>