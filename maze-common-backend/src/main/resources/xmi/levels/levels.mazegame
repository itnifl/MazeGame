/*
 * The levels of the game, written in the MazeGame DSL (Xtext). This is the source of levels.xmi:
 * MazeDslGenerator.levelsXmi turns it into the instance of levels.ecore that the game loads, and
 * MazeDslLevelsTest checks that the shipped levels.xmi says the same. See docs/level-authoring.md.
 */
game MazeGameLevels {

    level 1 "The Maze" {
    }

    level 2 "The Sergeants' Keep" {
        threatCapacity 1.5
        wallMaterials true
        inheritWeapons true
        cascadeDepth 2
        ring "Outer wall" materials STEEL_BASIC
        ring "Second ring" materials STONE_BASIC
        ring "Third ring" materials WOOD_BASIC
        ring "Inner ring" materials DIRT_BASIC, GLASS_BASIC
        sergeant "Zombie sergeant" {
            health 200
            sightRange 380.0
            rounds 5
            roundDamage 3
            roundInterval 0.12
            burstCooldown 1.2
            sprite "/main/game/maze/zombie-sergeant.png"
            fireSound "/main/game/maze/sounds/gatling-burst.wav"
            drops gatling
            postDistance 110.0
        }
        sergeants easy 1
        sergeants normal 4
        sergeants hard 6
    }

    level 3 "The Minefield" {
        basedOn 2
        mines {
            count 3
            ringRadius 62.0
            triggerRadius 22.0
            pulse 0.9
            blastRadius 150.0
            blastDamage 15
            playerDamage 20
            holeRadius 30.0
        }
        portalGhost "Portal ghost" {
            health 60
            speed 1.6
            sprite "/main/game/maze/ghost-portal.png"
        }
        portalGhosts easy 3
        portalGhosts normal 6
        portalGhosts hard 10
        teleport {
            cooldown 2.5
            banner "Teleported"
            bannerSeconds 1.6
            zapSound "/main/game/maze/sounds/teleport.wav"
            voiceSound "/main/game/maze/sounds/teleported.wav"
        }
    }

    level 4 "The Guard Towers" {
        basedOn 3
        mines {
            count 3
            ringRadius 62.0
            secondRing 118.0
            triggerRadius 22.0
            pulse 0.9
            blastRadius 150.0
            blastDamage 15
            playerDamage 20
            holeRadius 30.0
        }
        guardTower "Guard tower" {
            health 1500
            sightRange 650.0
            wallsOver 3
            rpgInterval 3.0
            rpgSpeed 300.0
            rpgBlastRadius 60.0
            rpgPlayerDamage 25
            rpgWallDamage 40
            gatlingRounds 6
            gatlingInterval 0.1
            gatlingDamage 3
            deathBlast 60
            sprite "/main/game/maze/guard-tower.png"
            rpgLaunchSound "/main/game/maze/sounds/rpg-launch.wav"
            rpgExplosionSound "/main/game/maze/sounds/rpg-explosion.wav"
            gatlingSound "/main/game/maze/sounds/gatling-burst.wav"
            hitSound "/main/game/maze/sounds/tower-hit.wav"
            destroyedSound "/main/game/maze/sounds/tower-destroyed.wav"
        }
        towers easy 2
        towers normal 3
        towers hard 4
    }

    level 5 "The Builders" {
        basedOn 4
        wallBuilder "Wall builder" {
            health 80
            speed 55.0
            sprite "/main/game/maze/zombie-builder.png"
            buildSeconds 3.0
            startRadius 4
            blockRadius 1
            spawnRadius 200.0
            material WOOD_BASIC
            buildSound "/main/game/maze/sounds/wall-build.wav"
        }
        builders easy 2
        builders normal 5
        builders hard 10
    }

    level 6 "The Lava Streams" {
        basedOn 5
        lava {
            streams 2
            width 46.0
            bridges 2
            bridgeLength 56.0
            meander 95.0
            wavelength 340.0
            flowSpeed 34.0
            glow 0.65
            crust 0.45
            deathSound "/main/game/maze/sounds/lava-death.wav"
        }
        lastLifeWeapon PULSE_CANNON shots 6
    }

    level 7 "The Haunted Crypt" {
        basedOn 6
        threatCapacity 2.2
        // the dead do not stay put: a swarm of portal ghosts keeps zapping the player about, in the middle of
        // the lava and the guns; a second ring of mines and more sergeants and towers make every landing deadly
        sergeants easy 2
        sergeants normal 6
        sergeants hard 9
        mines {
            count 4
            ringRadius 62.0
            secondRing 118.0
            triggerRadius 22.0
            pulse 0.9
            blastRadius 150.0
            blastDamage 15
            playerDamage 20
            holeRadius 30.0
        }
        portalGhosts easy 6
        portalGhosts normal 12
        portalGhosts hard 20
        teleport {
            cooldown 1.2
            banner "The crypt claims you"
            bannerSeconds 1.6
            zapSound "/main/game/maze/sounds/teleport.wav"
            voiceSound "/main/game/maze/sounds/teleported.wav"
        }
        towers easy 3
        towers normal 4
        towers hard 6
        lava {
            streams 3
            width 46.0
            bridges 2
            bridgeLength 56.0
            meander 95.0
            wavelength 340.0
            flowSpeed 40.0
            glow 0.8
            crust 0.35
            deathSound "/main/game/maze/sounds/lava-death.wav"
        }
        // using an expensive weapon of the shop brings the UFOs: they cross the map back and forth for ten seconds and
        // beam the ground close to the player (never at them); a beam that is bumped into takes half the health, a
        // shield blocks it. Ten red soldiers are dropped to hunt the player at the same time.
        ufoRaid {
            trigger EXPENSIVE
            ufos 2
            duration 10.0
            ufoSpeed 150.0
            beamEvery 1.5
            charge 0.8
            beamSeconds 1.2
            beamRadius 38.0
            aimMin 50.0
            aimMax 170.0
            damageFraction 0.5
            soldiers 10
            soldierHealth 60
            soldierDamage 4
            soldierSight 320.0
            soldierSeconds 45.0
            banner "UFO RETALIATION"
            ufoSprite "/main/game/maze/ufo/ufo.png"
            beamSprite "/main/game/maze/ufo/ufo-beam.png"
            arriveSound "/main/game/maze/sounds/airstrike-siren.wav"
            beamSound "/main/game/maze/sounds/pulse-fire.wav"
        }
    }
}
