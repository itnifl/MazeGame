<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- releng/maze.target -->
<target name="Maze Target" sequenceNumber="69">
  <locations>
    <!--
      make-javafx.ps1 populates releng/local-p2 first; the units it contains are
      selected in releng/mirror/pom.xml (EMF, OCL, Xtext, MWE2, Equinox and their
      dependencies).

      A Directory location takes an OS path rather than a URI. ${project_loc}
      expands to D:\... on Windows, which is a valid path but an invalid
      file: URI, so an InstallableUnit repository location cannot be used here.
    -->
    <location path="${project_loc:/MazeGame}/releng/local-p2" type="Directory"/>
  </locations>
</target>
