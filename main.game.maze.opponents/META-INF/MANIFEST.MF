Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: main.game.maze.opponents;singleton:=true
Automatic-Module-Name: main.game.maze.opponents
Bundle-Version: 1.0.0.qualifier
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-Localization: plugin
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .
Eclipse-ExtensibleAPI: true
Eclipse-RegisterBuddy: org.eclipse.emf.ecore
Require-Bundle: main.game.maze.difficulties,
 org.eclipse.emf.ecore;visibility:=reexport,
 org.eclipse.emf.common;visibility:=reexport,
 org.eclipse.emf.ecore.xmi;visibility:=reexport,
 org.eclipse.ocl.pivot;resolution:=optional,
 org.eclipse.ocl.ecore;resolution:=optional
Export-Package: main.game.maze.opponents,
 main.game.maze.opponents.constants,
 main.game.maze.opponents.impl,
 main.game.maze.opponents.util
