{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.format.settings.url": ".vscode/java-formatter.xml",
    "chat.agent.maxRequests": 65534,
    "java.debug.settings.forceBuildBeforeLaunch": false,
    "github.copilot.chat.runCommand.terminalAllowList": [
        "curl",
        "powershell",
        "pwsh",
        "Invoke-WebRequest",
        "Invoke-RestMethod",
        "Invoke-Command",
        "Invoke-Expression",
        "Invoke-Item",
        "Invoke-History",
        "Invoke-WmiMethod",
        "Invoke-CimMethod",
        "Start-Process",
        "Get-Content",
        "Set-Content",
        "New-Item",
        "Remove-Item",
        "Copy-Item",
        "Move-Item",
        "git",
        "gradlew",
        "gradle"
    ],
    "java.debug.settings.onBuildFailureProceed": true
}