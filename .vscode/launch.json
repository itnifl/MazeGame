// .vscode/launch.json
{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Launch MazeGame (JavaFX)",
            "request": "launch",
            "preLaunchTask": "Ensure Java 21",
            "envFile": "${workspaceFolder}/.vscode/maze.launch.env",
            "mainClass": "main.game.maze.App",
            "projectName": "main.game.maze",
            "vmArgs": [
                "--module-path",
                "${workspaceFolder}/maze/target/libs",
                "--add-modules",
                "javafx.controls,javafx.fxml,javafx.media"
            ]
        },
        {
            "type": "java",
            "name": "Launch MazeGame (libGDX backend)",
            "request": "launch",
            "preLaunchTask": "Ensure Java 21 (libGDX)",
            "envFile": "${workspaceFolder}/.vscode/maze.launch.env",
            "mainClass": "main.game.maze.libgdx.GdxAppLauncher",
            "projectName": "maze-libgdx"
        }
    ]
}