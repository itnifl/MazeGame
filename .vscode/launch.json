// .vscode/launch.json
{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Launch MazeGame (with dynamic paths)",
            "request": "launch",
            "preLaunchTask": "Ensure Java 21",
            "mainClass": "main.game.maze.App",
            "projectName": "main.game.maze",
            "vmArgs": [
                "--module-path",
                "${workspaceFolder}/maze/target/libs",
                "--add-modules",
                "javafx.controls,javafx.fxml,javafx.media"
            ]
        }
    ]
}