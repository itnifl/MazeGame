<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="mazecomp" nsURI="http://main.game.maze/mazecomp" nsPrefix="mazecomp">
  <eClassifiers xsi:type="ecore:EClass" name="MazeFile">
    <eStructuralFeatures xsi:type="ecore:EReference" name="zombies" upperBound="-1"
        eType="ecore:EClass platform:/resource/main.game.maze.opponents/src/main/resources/opponents.ecore#//Zombie"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ghosts" upperBound="-1"
        eType="ecore:EClass platform:/resource/main.game.maze.opponents/src/main/resources/opponents.ecore#//Ghost"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="pumpkinBombers" upperBound="-1"
        eType="ecore:EClass platform:/resource/main.game.maze.opponents/src/main/resources/opponents.ecore#//PumpkinBomber"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="lootTables" upperBound="-1"
        eType="ecore:EClass platform:/resource/main.game.maze.opponents/src/main/resources/opponents.ecore#//LootTable"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="lootItems" upperBound="-1"
        eType="ecore:EClass platform:/resource/main.game.maze.opponents/src/main/resources/opponents.ecore#//LootItem"
        containment="true"/>
  </eClassifiers>
</ecore:EPackage>
