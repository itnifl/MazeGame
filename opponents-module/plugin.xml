<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>

<!--
-->

<plugin>

   <extension point="org.eclipse.emf.ecore.generated_package">
      <!-- @generated opponents -->
      <package
            uri="http://main.game.maze/opponents"
            class="main.game.maze.opponents.OpponentsPackage"
            genModel="src/main/resources/opponents/opponents.genmodel"/>
   </extension>

   <extension point="org.eclipse.emf.ecore.extension_parser">
      <!-- @generated opponents -->
      <parser
            type="opponents"
            class="main.game.maze.opponents.util.OpponentsResourceFactoryImpl"/>
   </extension>

   <extension point="org.eclipse.emf.ecore.generated_package">
      <!-- @generated opponents -->
      <package
            uri="http://main.game.maze/difficulty"
            class="main.game.maze.difficulties.DifficultiesPackage"
            genModel="src/main/resources/opponents/opponents.genmodel"/>
   </extension>

   <extension point="org.eclipse.emf.ecore.extension_parser">
      <!-- @generated opponents -->
      <parser
            type="difficulties"
            class="main.game.maze.difficulties.util.DifficultiesResourceFactoryImpl"/>
   </extension>
</plugin>
