<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="highScoreRoot" fx:controller="main.game.maze.HighScoreController" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="800" prefHeight="600">
    <StackPane alignment="CENTER" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
               style="-fx-background-color: linear-gradient(to bottom, #14102a 0%, #251552 50%, #120c1f 100%);">
          <VBox alignment="CENTER" spacing="14" maxWidth="520"
              style="-fx-background-color: rgba(16, 10, 30, 0.88); -fx-border-color: #33ffbb; -fx-border-width: 3; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.75), 24, 0.2, 0, 10);">
            <padding>
                <Insets top="26" right="28" bottom="24" left="28" />
            </padding>

            <Label text="HALL OF FAME"
                   style="-fx-font-size: 42px; -fx-font-family: 'Consolas'; -fx-font-weight: bold; -fx-text-fill: #ffe56e; -fx-effect: dropshadow(one-pass-box, rgba(255,229,110,0.6), 10, 0.2, 0, 2);" />

            <Label text="TOP SCORERS"
                   style="-fx-font-size: 15px; -fx-font-family: 'Consolas'; -fx-text-fill: #8fffe0; -fx-opacity: 0.95;" />

            <VBox fx:id="highScoresVBox" spacing="6" alignment="CENTER"
                  style="-fx-background-color: rgba(0,0,0,0.24); -fx-border-color: #8fffe0; -fx-border-width: 1; -fx-padding: 14 20 14 20;" />

            <HBox alignment="CENTER" spacing="14">
                <Button fx:id="continueButton" text="CONTINUE GAME" onAction="#continueGame"
                        style="-fx-min-width: 200; -fx-min-height: 42; -fx-font-size: 16px; -fx-font-family: 'Consolas'; -fx-font-weight: bold; -fx-background-color: #8fffe0; -fx-text-fill: #0d2a25; -fx-background-radius: 0; -fx-border-color: #0d2a25; -fx-border-width: 2; -fx-cursor: hand;" />
                <Button fx:id="restartButton" text="RESTART GAME" onAction="#restartGame"
                        style="-fx-min-width: 200; -fx-min-height: 42; -fx-font-size: 16px; -fx-font-family: 'Consolas'; -fx-font-weight: bold; -fx-background-color: #ffe56e; -fx-text-fill: #2f1d00; -fx-background-radius: 0; -fx-border-color: #2f1d00; -fx-border-width: 2; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </StackPane>
</AnchorPane>
