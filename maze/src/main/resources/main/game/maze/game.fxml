<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Background?>
<?import javafx.scene.layout.BackgroundImage?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root" onMouseClicked="#handleMouseClicked" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.game.maze.GameController">    
    <Pane fx:id="gameBoard" focusTraversable="true" onKeyPressed="#handleKeyPressed" onKeyReleased="#handleKeyReleased" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        
        <background>
            <Background>
                <images>
                    <BackgroundImage>
                        <image>
                            <Image url="@gameBackGround1.png" />
                        </image>
                        <repeatX>REPEAT</repeatX>
                        <repeatY>REPEAT</repeatY>
                    </BackgroundImage>
                </images>
            </Background>
        </background>

        
        <ImageView fx:id="player" fitHeight="30" layoutX="0" layoutY="52" preserveRatio="true">
            <image><Image url="@you2.png" /></image>
        </ImageView>

        <ImageView fx:id="heart" fitHeight="50" layoutX="400" layoutY="300" preserveRatio="true">
            <image><Image url="@heart2.png" /></image>
        </ImageView>        
    </Pane>    
    <ProgressBar fx:id="hpBar" layoutX="1" layoutY="1" prefHeight="20" prefWidth="800" style="-fx-accent: #c0392b;" />

    <Label fx:id="mouseCoordsLabel" layoutX="1.0" layoutY="23.0" prefHeight="20" prefWidth="100" />

    <AnchorPane prefHeight="1" prefWidth="150" AnchorPane.bottomAnchor="1" AnchorPane.rightAnchor="10">
        <Label fx:id="coordinatesLabel" text="X: 0, Y: 0" />
    </AnchorPane>

    <AnchorPane fx:id="scoreHudContainer" prefHeight="30" prefWidth="170" style="-fx-background-color: rgba(0, 0, 0, 0.45); -fx-border-color: #8fffe0; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4;" AnchorPane.rightAnchor="6" AnchorPane.topAnchor="22">
        <Label fx:id="scoreLabel" text="Score: 0" style="-fx-font-size: 17px; -fx-font-family: 'Consolas'; -fx-font-weight: bold; -fx-text-fill: #ffe56e; -fx-padding: 8 10 8 10;" />
    </AnchorPane>

    <AnchorPane fx:id="bottomMenuContainer" prefHeight="40" style="-fx-background-color: rgba(0, 0, 0, 0.35); -fx-border-color: rgba(143,255,224,0.7); -fx-border-width: 1 0 0 0;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox alignment="CENTER_LEFT" spacing="10" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="0">
            <Button fx:id="commandsMenuButton" text="Commands" onAction="#toggleCommandsOverlay" style="-fx-background-color: rgba(143,255,224,0.85); -fx-text-fill: #103630; -fx-font-family: 'Consolas'; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4;" />
            <Label text="Open keyboard command help" style="-fx-text-fill: #d7fff5; -fx-font-family: 'Consolas'; -fx-font-size: 13px;" />
        </HBox>
    </AnchorPane>

    <AnchorPane fx:id="commandsOverlay" visible="false" managed="false" style="-fx-background-color: rgba(0, 0, 0, 0.38);" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <VBox maxWidth="460" spacing="10" style="-fx-background-color: rgba(20, 16, 42, 0.9); -fx-border-color: #8fffe0; -fx-border-width: 2; -fx-padding: 18;" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="60">
            <Label text="Commands" style="-fx-text-fill: #ffe56e; -fx-font-size: 24px; -fx-font-family: 'Consolas'; -fx-font-weight: bold;" />
            <Label text="Arrow Keys: Move player" style="-fx-text-fill: #f2f8ff; -fx-font-family: 'Consolas'; -fx-font-size: 15px;" />
            <Label text="H: Open high score screen" style="-fx-text-fill: #f2f8ff; -fx-font-family: 'Consolas'; -fx-font-size: 15px;" />
            <Label text="ESC: Difficulty and restart prompt" style="-fx-text-fill: #f2f8ff; -fx-font-family: 'Consolas'; -fx-font-size: 15px;" />
            <Label text="P: Show shortest path to heart (release to clear)" style="-fx-text-fill: #f2f8ff; -fx-font-family: 'Consolas'; -fx-font-size: 15px;" />
            <Label text="O: Show spanning tree (release to clear)" style="-fx-text-fill: #f2f8ff; -fx-font-family: 'Consolas'; -fx-font-size: 15px;" />
            <Label text="Warning: Showing shortest path continuously reduces score over time." style="-fx-text-fill: #ffb27a; -fx-font-family: 'Consolas'; -fx-font-size: 14px; -fx-font-weight: bold;" />
            <Button text="Close" onAction="#hideCommandsOverlay" style="-fx-background-color: #ffe56e; -fx-text-fill: #2f1d00; -fx-font-family: 'Consolas'; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 3;" />
        </VBox>
    </AnchorPane>
</AnchorPane>
