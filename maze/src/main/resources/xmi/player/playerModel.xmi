      ImageTurnRight="/main/game/maze/you2.png"
      ImageTurnUp="/main/game/maze/you2.png"
      ImageTurnDown="/main/game/maze/you2.png"
      ImageDeath="/main/game/maze/you2-dead.png"/>
</player:PlayerModel>
