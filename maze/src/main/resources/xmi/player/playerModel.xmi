<?xml version="1.0" encoding="UTF-8"?>
<player:PlayerModel
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:player="http://main.game.maze/player"
    name="MazeGamePlayer">
  <playerCharacter
      id="player_default"
      displayName="Player"
      enabled="true"
      health="100"
      speed="10.0"
