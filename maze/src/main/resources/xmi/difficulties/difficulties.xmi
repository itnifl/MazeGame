<?xml version="1.0" encoding="UTF-8"?>
<diff:DifficultyGameData
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:diff="http://main.game.maze/difficulty">

  <!-- EASY -->
  <difficulties xmi:id="easy" xsi:type="diff:EasyDifficulty"
                instantDeath="false"
                monstersMovementSpeedMultiplier="1.05"
                monstersDamageMultiplier="0.70"
                maxThreat="10">
    <enemyMaxCount>
      <type>GHOST</type>
      <maxCount>2</maxCount>
    </enemyMaxCount>
    <enemyMaxCount>
      <type>ZOMBIE</type>
      <maxCount>4</maxCount>
    </enemyMaxCount>
  </difficulties>

  <!-- NORMAL -->
  <difficulties xmi:id="normal" xsi:type="diff:NormalDifficulty"
                instantDeath="false"
                monstersMovementSpeedMultiplier="1.00"
                monstersDamageMultiplier="1.00"
                maxThreat="20">
    <enemyMaxCount>
      <type>GHOST</type>
      <maxCount>4</maxCount>
    </enemyMaxCount>
    <enemyMaxCount>
      <type>ZOMBIE</type>
      <maxCount>6</maxCount>
    </enemyMaxCount>
  </difficulties>

  <!-- HARD -->
  <difficulties xmi:id="hard" xsi:type="diff:HardDifficulty"
                instantDeath="false"
                monstersMovementSpeedMultiplier="1.40"
                monstersDamageMultiplier="1.60"
                maxThreat="30">
    <enemyMaxCount>
      <type>GHOST</type>
      <maxCount>6</maxCount>
    </enemyMaxCount>
    <enemyMaxCount>
      <type>ZOMBIE</type>
      <maxCount>10</maxCount>
    </enemyMaxCount>
  </difficulties>

  <currentDifficulty href="#normal"/>
</diff:DifficultyGameData>