<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>main.game.maze</groupId>
    <artifactId>MazeGame</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <!-- We recommend adding a <relativePath/> to the parent POM -->
    <relativePath>../</relativePath>
  </parent>

  <artifactId>main.game.maze</artifactId>
  <packaging>eclipse-plugin</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <tycho.version>5.0.0</tycho.version>
    <javafx.version>21.0.9</javafx.version>
    <junit.jupiter.version>5.13.4</junit.jupiter.version>
    <maven.compiler.plugin.version>3.14.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.5.3</maven.surefire.plugin.version>
    <maven.failsafe.plugin.version>3.5.3</maven.failsafe.plugin.version>
    <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
  </properties>

  <!-- These repositories are for Maven artifacts and Tycho plugins -->
  <repositories>
     <repository>
        <id>central</id>
        <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <id>efxclipse-releases</id>
      <url>https://download.eclipse.org/efxclipse/releases/4.0.0</url>
    </repository>
    <repository>
        <id>eclipse-releases</id>
        <url>https://repo.eclipse.org/content/repositories/releases/</url>
    </repository>
    <repository>
      <id>openjfx</id>
      <url>https://maven.openjfx.io</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
        <id>eclipse-releases</id>
        <url>https://repo.eclipse.org/content/repositories/releases/</url>
    </pluginRepository>
    <pluginRepository>
        <id>openjfx-repo</id>
        <url>https://maven.openjfx.io</url>
    </pluginRepository>
  </pluginRepositories>

  <!-- Non-p2/OSGi Maven dependencies -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.common</artifactId>
      <version>2.43.0</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore</artifactId>
      <version>2.38.0</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
      <version>2.38.0</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.ocl</groupId>
      <artifactId>org.eclipse.ocl.ecore</artifactId>
      <version>3.3.100.v20140610-0641</version> 
    </dependency>
    <dependency>
      <groupId>org.eclipse.ocl</groupId>
      <artifactId>org.eclipse.ocl.common</artifactId>
      <version>1.2.0.v20140610-0641</version>
    </dependency>
    <!-- JavaFX LTS 21.0.8 -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-media</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
        <groupId>main.game.maze</groupId>
        <artifactId>main.game.maze.opponents</artifactId>
        <version>1.0.0-SNAPSHOT</version> 
        <scope>compile</scope>
    </dependency>
    <dependency>
        <groupId>main.game.maze</groupId>
        <artifactId>main.game.maze.difficulty</artifactId>
        <version>1.0.0-SNAPSHOT</version> 
        <scope>compile</scope>
    </dependency>
    <dependency>
        <groupId>main.game.maze</groupId>
        <artifactId>main.game.maze.behaviour</artifactId>
        <version>1.0.0-SNAPSHOT</version> 
        <scope>compile</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- JavaFX Maven plugin -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <executions>
          <execution>
            <goals>
              <goal>jlink</goal>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Enable Tycho for OSGi-aware builds -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>

      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <target>
            <location>
              <type>p2</type>
              <url>http://download.eclipse.org/releases/2021-12</url>
            </location>
          </target>
          <extraRequirements>
            <requirement type="eclipse-plugin" id="org.openjfx.javafx.base"/>
            <requirement type="eclipse-plugin" id="org.openjfx.javafx.controls"/>
            <requirement type="eclipse-plugin" id="org.openjfx.javafx.graphics"/>
            <requirement type="eclipse-plugin" id="org.openjfx.javafx.media"/>
          </extraRequirements>
          <!-- Enable wrapping of non-OSGi JavaFX dependencies -->
          <pomDependencies>wrapAsBundle</pomDependencies>
        </configuration>
      </plugin>

      <!-- Configure the compiler -->
      <plugin>      
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-compiler-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <source>21</source>
          <target>21</target>
        </configuration>
      </plugin>

      <!-- Configure testing -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-surefire-plugin</artifactId>
        <version>${tycho.version}</version>
      </plugin>
    </plugins>
  </build>
</project>