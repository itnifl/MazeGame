<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>main.game.maze</groupId>
    <artifactId>MazeGame</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <groupId>main.game.maze</groupId>
  <artifactId>main.game.maze</artifactId>
  <packaging>eclipse-plugin</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <tycho.version>5.0.0</tycho.version>
  </properties>

  <!-- p2 repos: SimRel + OCL + e(fx)clipse runtime -->
  <repositories>
    <repository>
      <id>eclipse-2025-09</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/releases/2025-09/</url>
    </repository>
    <repository>
      <id>ocl-latest</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/modeling/mdt/ocl/updates/releases/latest/</url>
    </repository>
    <repository>
      <id>efxclipse-runtime</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/efxclipse/runtime-released/3.11.0/repository</url>
    </repository>
  </repositories>

  <!-- Keep ONLY non-p2 Maven deps here (if any). Prefer OSGi/p2 for Tycho. -->
  <dependencies>
    <!-- (Optional) JUnit via Maven; or use p2 Orbit bundles instead -->
    
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Enable Tycho (OSGi-aware build) -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>

      <!-- Resolve from p2; allow Maven deps if you temporarily need them -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <resolver>p2</resolver>
          <pomDependencies>consider</pomDependencies>
        </configuration>
      </plugin>

      <!-- Compile with ECJ via Tycho -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-compiler-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <source>21</source>
          <target>21</target>
        </configuration>
      </plugin>

      <!-- Run tests inside OSGi (use p2 JUnit 5 bundles or keep the Maven dep above) -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-surefire-plugin</artifactId>
        <version>${tycho.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
