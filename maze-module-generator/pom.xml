<!-- /maze-module-generator/pom.xml -->
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>main.game.maze</groupId>
    <artifactId>MazeGame</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>maze-module-generator</artifactId>
  <packaging>jar</packaging>
  <name>maze-module-generator</name>

  <properties>
    <junit.jupiter.version>5.10.2</junit.jupiter.version>
  </properties>

  <dependencies>
    <!-- Code generator (Acceleo 4 eclipse-plugin, installed to local Maven repo by Tycho) -->
    <dependency>
      <groupId>main.game.maze</groupId>
      <artifactId>maze-generator-java</artifactId>
      <version>${project.version}</version>
    </dependency>
    
    <!-- Acceleo 4 runtime (manually installed from P2 to local Maven repo) -->
    <dependency>
      <groupId>org.eclipse.acceleo</groupId>
      <artifactId>org.eclipse.acceleo.aql</artifactId>
      <version>4.2.1</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.acceleo</groupId>
      <artifactId>org.eclipse.acceleo.query</artifactId>
      <version>8.1.1</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.acceleo</groupId>
      <artifactId>org.eclipse.acceleo.annotations</artifactId>
      <version>8.1.1</version>
    </dependency>
    <dependency>
      <groupId>org.antlr</groupId>
      <artifactId>antlr4-runtime</artifactId>
      <version>4.13.2</version>
    </dependency>
    
    <dependency>
      <groupId>main.game.maze</groupId>
      <artifactId>main.game.maze.walls</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>main.game.maze</groupId>
      <artifactId>main.game.maze.opponents</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>main.game.maze</groupId>
      <artifactId>main.game.maze.difficulties</artifactId>
      <version>${project.version}</version>
    </dependency>
    
    <!-- Test dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
        <!-- Run Java code generator -->
        <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.1</version>
            <executions>
                <execution>
                    <id>generate-code</id>
                    <phase>generate-sources</phase>
                    <goals><goal>java</goal></goals>
                    <configuration>
                        <mainClass>main.game.maze.codegen.AcceleoGeneratorMain</mainClass>
                        <arguments>
                            <argument>${project.basedir}/../maze/src/main/resources/xmi/opponents/opponentModel.xmi</argument>
                            <argument>${project.basedir}/../maze/src/main/resources/xmi/walls/default.walls.xmi</argument>
                            <argument>${project.basedir}/src-gen</argument>
                        </arguments>
                        <includeProjectDependencies>true</includeProjectDependencies>
                        <includePluginDependencies>false</includePluginDependencies>
                    </configuration>
                </execution>
            </executions>
        </plugin>
        <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
                <execution>
                    <id>add-generated</id>
                    <phase>generate-sources</phase>
                    <goals><goal>add-source</goal></goals>
                    <configuration>
                        <sources>
                            <source>src-gen</source>
                        </sources>
                    </configuration>
                </execution>
            </executions>
        </plugin>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.2.5</version>
            <configuration>
                <includes>
                    <include>**/*Test.java</include>
                </includes>
            </configuration>
        </plugin>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.12.1</version>
            <configuration>
                <source>17</source>
                <target>17</target>
            </configuration>
        </plugin>
    </plugins>
  </build>
</project>